{% assign sid = section.id %}
<style>
    #shopify-section-{{ sid }} .e_banner{
      position:relative;
    }
    #shopify-section-{{ sid }} .e_banner::before{
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      z-index: 1;
      width: 100%;
      height: 100%;
      background: #000;
      opacity:{{section.settings.overlayer | divided_by:100.0}};
    }
    #shopify-section-{{ sid }} .page-width{
      --page-width:1360px;
      width: 100%;
      height: 100%;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      flex-direction: column;
      color:#fff;
    }
    #shopify-section-{{ sid }} img{
      width:100%;
      height:auto;
      display:block;
    }
    #shopify-section-{{ sid }} .content{
      position:absolute;
      top:0;
      left:0;
      z-index:2;
      width:100%;
      height:100%;
    }
    #shopify-section-{{ sid }} .content__box{
      max-width:800px;
    }
    #shopify-section-{{ sid }} .content .banner-title{
      font-size: 40px;
      font-weight: 500;
      line-height: 1.4;
    }
    #shopify-section-{{ sid }} .content .banner-text{
      font-size: 20px;
      font-weight: 400;
      line-height: 1.4;
      margin-top:12px;
      opacity:0.8;
    }
    #shopify-section-{{ sid }} .content .banner-btn{
      margin-top:24px;
      color: #FFF;
      font-size: 16px;
      font-weight: 500;
      line-height: 1.4; 
      background:#000;
      border-radius: 8px;
      padding:8px 20px;
      display:inline-block;
    }
    #shopify-section-{{ sid }} .content .banner-btn.style_2{
      background:#fff;
      color: #000;
      
    }
    #shopify-section-{{ sid }} .content .banner-btn.style_3{
      background:#f47c20;
    }
  @media (max-width:959px){
    #shopify-section-{{ sid }} .page-width{
      justify-content: flex-end;
    }
    
    #shopify-section-{{ sid }} .content__box{
      max-width:320px;
      padding-bottom:24px;
    }
    {% if section.settings.hide %}
      #shopify-section-{{ sid }} picture{
        display:none;
      }
      #shopify-section-{{ sid }} .content{
        position:unset;
      }
    #shopify-section-{{ sid }} .page-width{
        color:#000;
        padding-top: 40px;

    }
      {% if section.index == 1 %}
          {% assign template_name = template | replace: '.', ' ' | truncatewords: 2, '' | handle %}
        {% if template_name == 'page-collection' or template_name =='collection-spx-collection' %}
            #HeaderWrapper.header-wrapper--overlay{
              position:unset;
            }
            #HeaderWrapper:not(.header-wrapper--compressed) .site-header__element{
              --colorStickyNavLinks:#000;
            }
            #HeaderWrapper:not(.header-wrapper--compressed) .site-header__element .logo--has-inverted{
                  opacity: 1;
                visibility: visible;
                overflow: hidden;
                height: auto;
            }
            #HeaderWrapper:not(.header-wrapper--compressed) .site-header__element .logo--inverted{
                opacity: 0;
                visibility: hidden;
                overflow: hidden;
                height: 0;
            }
          {% endif %}
      {% endif %}
    {% endif %}
    #shopify-section-{{ sid }} .content .banner-title{
      font-size: 28px;
      font-weight: 500;
      line-height: 1.4;
    }
    #shopify-section-{{ sid }} .content .banner-text{
      font-size: 14px;
      margin-top:8px;
    }
    #shopify-section-{{ sid }} .content .banner-btn{
      margin-top:12px;
      font-size: 16px;
      padding:8px 20px;
    }
  }
</style>
<div class="e_banner">
  {% liquid
        assign pc_image = section.settings.img
        assign mobile_image = section.settings.img_m
        assign alt = section.settings.img.alt
    %}
    
    <picture>
        <source srcset="{{ mobile_image | img_url: '750x' }}"
                media="(max-width: 375px)">
        <source srcset="{{ mobile_image | img_url: '1536x' }}"
                media="(max-width: 768px)">
        <source srcset="{{ pc_image | img_url: '2160x' }}"
                media="(max-width: 1080px)">
        <source srcset="{{ pc_image | img_url: '2400x' }}"
                media="(max-width: 1200px)">
        <source srcset="{{ pc_image | img_url: '3840x' }}"
                media="(max-width: 1920px)">
        <img src="{{ pc_image | img_url: '3840x' }}" alt="{{ alt }}" loading="lazy" width="auto" height="100%">
    </picture>
    <div class="content">
      <div class="page-width">
        <div class="content__box">
          {% if section.settings.title != blank %}
           <h2> <div class="banner-title">{{ section.settings.title }}</div></h2>
          {% endif %}
          {% if section.settings.text != blank %}
            <div class="banner--text">{{ section.settings.text }}</div>
          {% endif %}
          {% if section.settings.btn != blank %}
            <a class="banner-btn {% if section.settings.btn_style == '2' %}style_2{% endif %} {% if section.settings.btn_style == '3' %}style_3{% endif %}" href="{{ section.settings.link }}">{{ section.settings.btn }}</a>
          {% endif %}
        </div>
      </div>
    </div>
</div>

{% schema %}
  {
    "name": "Section banner",
    "settings": [
      {
        "type": "image_picker",
        "id": "img",
        "label": "image (desktop)"
      },
      {
        "type": "image_picker",
        "id": "img_m",
        "label": "image (mobile)"
      },
      {
        "type": "checkbox",
        "id": "hide",
        "label": "隐藏m端"
      },
      {
        "type": "range",
        "id":"overlayer",
        "label": "Overlayer opacity",
        "max": 100,
        "min": 1,
        "step": 1,
        "default":30
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title"
      },
      {
        "type": "text",
        "id": "text",
        "label": "Text"
      },
      {
        "type": "text",
        "id": "btn",
        "label": "Button"
      },
      {
        "type": "url",
        "id": "link",
        "label": "link"
      },
      {
        "type": "select",
        "id": "btn_style",
        "label": "Button style",
        "options": [
          {
            "label": "1",
            "value": "1"
          },
          {
            "label": "2",
            "value": "2"
          },
          {
            "label": "3",
            "value": "3"
          }
        ],
        "default":"1"
      }
    ],
    "presets": [
      {
        "name": "Section banner"
      }
    ]
  }
{% endschema %}