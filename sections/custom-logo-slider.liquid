  <div class="page-width-full">
  {%- if section.blocks.size > 0 -%}
    <div class="slideshow-wrapper swiper-container">
      <div
        class="swiper-wrapper"
        id="Testimonials-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div
            class="swiper-slide testimonials-slide--{{ block.id }}"
            data-index="{{ forloop.index0 }}"
            data-aos="row-of-{{ section.blocks.size }}"
            {{ block.shopify_attributes }}>
            <div class="testimonials-slider__text">
              {%- if block.settings.image != blank -%}
                <div class="testimonail-image{% if section.settings.round_images %} testimonail-image--round{% endif %}">
                  <div class="image-wrap">
                    {%- assign img_url = block.settings.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
                    <img class="lazyload " src="{{ block.settings.image | image_url:  width: 300 }}" alt="{{ block.settings.image.alt }}">
                    <noscript>
                      <img class="lazyloaded " src="{{ block.settings.image | image_url: width:300 }}" alt="{{ block.settings.image.alt }}">
                    </noscript>
                  </div>
                </div>
              {%- endif -%}
                {%- if block.settings.title != blank -%}
              <div class="rb_bottom">            
                            {{ block.settings.title }}               
                    </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
      
  
    </div>
     
  {%- endif -%}
