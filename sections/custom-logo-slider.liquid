{% style %}
  .logo-section {    padding:15px 0; }
   {%- if section.settings.white_bg   -%}
    .image-carousel-section { background:#FFFFFF; }
     {% else %}
     .image-carousel-section { background:#F1EEE7; }
   {%- endif -%}
   .image-carousel-section .asrv-star-widget > div{margin:0 0.3rem;}
  .testimonial-stars-row svg{
    width:20px; height:20px; max-width:20px; fill:#FF6A00;
  }
.slideshow-wrapper {
  position: relative;
  overflow: hidden; /* Ensures the gradients don't spill out */
}

.slideshow-wrapper::before,.slideshow-wrapper::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 200px; 
  z-index: 2;
  pointer-events: none;  
}
  .logo-section .section-header{
    margin-bottom:0.5rem;
  }
@media(min-width:769px){
.logo-section .section-header h2{
  font-size:2rem;
}
.logo-section .slideshow-wrapper::before {
  left: 0;
  background: linear-gradient(to right, rgba(241, 238, 231, 1), rgba(241, 238, 231, 0)); 
}
.logo-section .slideshow-wrapper::after {
  right: 0;
  background: linear-gradient(to left, rgba(241, 238, 231, 1), rgba(241, 238, 231, 0)); 
}
 {%- if section.settings.white_bg   -%}
.logo-section .slideshow-wrapper::before {
  left: 0;
  background: linear-gradient(to right, rgba(255, 255, 2255, 1), rgba(255, 255, 255, 0)); 
}
.logo-section .slideshow-wrapper::after {
  right: 0;
  background: linear-gradient(to left, rgba(255, 255, 255, 1), rgba(255, 255, 255, 0)); 
}
 {%- endif -%}
}
  .page-width-narrow{ margin:0 auto; position:relative;}
  @media(max-width:768px){
      .logo-section {    padding:0; }
  }
{% endstyle %}
 
 
 <script>
 $(document).ready(function() {
    var sectionId = "{{ section.id }}";
    var $swiperContainer = $('.testimonials-' + sectionId + ' .swiper-container');

    var swiper = new Swiper($swiperContainer[0], {
        spaceBetween: 0,
        loop: true,
        autoplay: {
            delay: 0, // No delay for continuous scrolling
            disableOnInteraction: false,
        },
        speed: 5000,  
        slidesPerView: '5',  
        loopedSlides: 20,  
        freeMode: false,  
        allowTouchMove: false,  
        centeredSlides: false,  
        resistance: false,  
        cssMode: false, 
        loopAdditionalSlides: 30,  
        navigation: {
            nextEl: '.testimonials-' + sectionId + ' .swiper-button-next',
            prevEl: '.testimonials-' + sectionId + ' .swiper-button-prev',
        },
        breakpoints: {
            0: {
                slidesPerView: 2.5,
                spaceBetween: 0,
            },
            769: {
                slidesPerView: 5,
                spaceBetween: 0,
            }
        }
    });

   
    $('.testimonials-' + sectionId + ' .swiper-container').on('mouseenter', function() {
        swiper.setTransition(200); 
        swiper.params.speed = 500;  
        swiper.autoplay.stop();  
        swiper.update();  
    });

 
    $('.testimonials-' + sectionId + ' .swiper-container').on('mouseleave', function() {
        swiper.setTransition(0);  
        swiper.params.speed = 5000; 
        swiper.autoplay.start();  
        swiper.update();  
    });
});
</script>

 
