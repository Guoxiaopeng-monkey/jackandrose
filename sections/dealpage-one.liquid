{% assign sid = section.id %}
<style>
    #shopify-section-{{ sid }} {
       background:{{section.settings.bg}};
        {% if section.settings.bg != blank %}
        padding: {{section.settings.padding_pc}};
        {% else %}
        margin: {{section.settings.padding_pc}};
        {% endif %}
      overflow:hidden;
    }
    #shopify-section-{{ sid }} .page-width{
      --page-width:1360px;
    }
    #shopify-section-{{ sid }} .product-section-info{
      margin-bottom:40px;
    }
    #shopify-section-{{ sid }} .product-section-title{
      color: #000;
      font-size: 36px;
      font-weight: 500;
      line-height: 1.4;
    }
    #shopify-section-{{ sid }} .pcs_swiper_box>.swiper-container{
        /* padding-left: calc((100% - var(--page-width))/2); */
          overflow: visible;
      padding-bottom:60px:
    }
    #shopify-section-{{ sid }} .swiper-wrapper{
      display: flex;
      align-items: stretch;
    }
    #shopify-section-{{ sid }} .swiper-slide{
      height: auto;
      display: flex;
      flex-direction: column;
    }
    #shopify-section-{{ sid }} .swiper-slide .e_product_item{
      height: 100%;
      display: flex;
      flex-direction: column;
    }
    #shopify-section-{{ sid }} .swiper-slide .e_meida{
      aspect-ratio: 1;
      width: 100%;
      flex-shrink: 0;
    }
    #shopify-section-{{ sid }} .swiper-slide .e_meida img{
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    /* #shopify-section-{{ sid }} .swiper-button-prev, #shopify-section-{{ sid }} .swiper-button-next{
      width:var(--swiper-navigation-size);
    }
    #shopify-section-{{ sid }} .swiper-button-prev:after, #shopify-section-{{ sid }} .swiper-button-next:after{ }
    #shopify-section-{{ sid }} .swiper-button-prev{
      left:18%;
    }
    #shopify-section-{{ sid }} .swiper-button-next{
      right:18%;
    }
    #shopify-section-{{ sid }} .swiper-button {top:40%;}
    #shopify-section-{{ sid }} .swiper-button svg{width:30px; height:30px;} */
    #shopify-section-{{ sid }} .swiper-pagination{
      position: static;
      margin-top: 40px;
    }
    #shopify-section-{{ sid }} .swiper-pagination-bullet{
      margin: 0 5px;
      background:rgba(0,0,0,0.3);
      width: 50px;
      height: 6px;
      position: relative;
      border-radius: 4px;
      overflow: hidden;
      cursor: pointer;
    }
    #shopify-section-{{ sid }} .swiper-pagination-bullet-active{
        opacity:1;
      background:rgba(0,0,0,1);

    }
    /* #shopify-section-{{ sid }} .swiper-pagination-bullet-active::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 100%;
      background:#fff;
      animation: progress 5s linear forwards;
    }
    @keyframes progress {
      from {
        width: 0;
      }
      to {
        width: 100%;
      }
    } */
    .title-left{
      text-align:left
    }
    .title-center{
      text-align:center
    }
  @media (max-width:959px){
    #shopify-section-{{ sid }} {
      {% if section.settings.bg != blank %}
      padding: {{section.settings.padding_m}};
      {% else %}
      margin: {{section.settings.padding_m}};
      {% endif %}
    }
    #shopify-section-{{ sid }} .product-section-info{
      margin-bottom:24px;
    }
    #shopify-section-{{ sid }} .product-section-title{
      font-size: 20px;
    }
    #shopify-section-{{ sid }} .swiper-pagination-bullet{
      margin: 0 3px;
      width: 28px;
      height: 4px;
    }
    #shopify-section-{{ sid }} .swiper-pagination{
      margin-top: 24px;
    }
     .md\:title-left{
      text-align:left
    }
    .md\:title-center{
      text-align:center
    }
  }
</style>

<div class="product-deal_one" id="product-deal_one">
  <div class="page-width">
    <div class="product-section-info">
      {% if section.settings.title != blank %}
        <h2 class="{{section.settings.title_position }}  {{section.settings.title_position_mb }}">
          <div class="product-section-title {{section.setting.title_position }}  {{section.settings.title_position_mb }}">{{ section.settings.title }}</div>
        </h2>
      {% endif %}
    </div>
    <div class="pcs_swiper_box">
      <div class="swiper-container">
        <div class="swiper-wrapper">
          {% for product in section.settings.collection.products %}
            <div class="swiper-slide pcs_blocks-slide">
              {% render 'e_product-card', product: product, layout: true, collection: section.settings.collection %}
            </div>
          {% endfor %}
        </div>
        <div class="swiper-pagination"></div>
        <!--
          <div class="swiper-button-prev">
          </div>
          <div class="swiper-button-next">
          </div>
        -->
      </div>
    </div>
  </div>
</div>

<script type="module">
  var productSwiper{{section.index}} = new Swiper("#shopify-section-{{ sid }} .swiper-container", {
      slidesPerView: 3.5,
      spaceBetween: 20,
     pagination: {
          el: '#shopify-section-{{ sid }} .swiper-pagination',
          clickable: true
      },
      // navigation: {
      //     nextEl: '#shopify-section-{{ sid }} .swiper-button-next',
      //     prevEl: '#shopify-section-{{ sid }} .swiper-button-prev',
      // },

  	breakpoints: {
       0: {
            slidesPerView: 1.2,
            spaceBetween: 12,
        },
      960: {
            slidesPerView: 3.5,
            spaceBetween: 20,
        }
       }
    });
</script>

{% schema %}
{
  "name": "products list slide",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Hot Sale"
    },
    {
      "type":"select",
      "id":"title_position",
      "label":"Title Position",
      "options":[
        {
          "value":"title-left",
          "label":"Left"
        },
                {
          "value":"title-center",
          "label":"Center"
        }
      ],
      "default":"title-left"
    },
    {
      "type":"select",
      "id":"title_position_mb",
      "label":"Title Position Mobile",
      "options":[
        {
          "value":"md:title-left",
          "label":"Left"
        },
                {
          "value":"md:title-center",
          "label":"Center"
        }
      ],
      "default":"md:title-left"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "select",
      "id": "display_title_type",
      "label": "Title type",
      "options": [
        { "value": "collection", "label": "Collection" },
        { "value": "bundles", "label": "Bundles" },
        { "value": "discount", "label": "Discount" },
        { "value": "default", "label": "Default" }
      ],
      "default": "default"

    },
    {
      "type": "checkbox",
      "id": "display_special_attr",
      "label": "Display special attribute",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "text",
      "id": "padding_pc",
      "label": "Padding (desktop)",
      "default": "50px 0"
    },
    {
      "type": "text",
      "id": "padding_m",
      "label": "Padding (mobile)",
      "default": "40px 0"
    }
  ],
  "presets": [
    {
      "name": "products list slide"
    }
  ]
}
{% endschema %}
