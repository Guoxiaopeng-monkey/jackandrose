    border: 1px solid rgb(30, 30, 30, 0.2);
    width: 100%;
    height: 48px;
    line-height: 48px;
    flex-shrink: 0;
    padding-left: 15px;
    padding-right: 14%;
    outline:unset;
        box-shadow: unset;
  }
  
  .subscribe-popup__btn {
    width: 40px;
    height: 40px;
    line-height: 48px;
    flex-shrink: 0;
    background: unset;
    color: #000;
    text-align: center;
    font-size: 16px;
    font-style: normal;
    font-weight: 600;
    border: none;
    outline: none;
    position: absolute;
    right: 2%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  
  .subscribe-popup__btn svg {
    width: 20px;
  }
  .subscribe-popup__button{
        background: #000;
    color: #fff;
    width: 100%;
    border: unset;
    font-size: 18px;
    height: 46px;
    border-radius: 12px;
    margin-top: 20px;
  }
    span.subscribe-popup_tips {
    font-size: 12px;
    margin-top: 12px;
    display: block;
    color: #949494;
}
    .subscribe-popup_footer>* {
