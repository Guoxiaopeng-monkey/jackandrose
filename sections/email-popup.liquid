      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap-reverse;
              position: relative;
    }
  .subscribe-popup-box-close{
        top: 5%;
    right: 5%;
  }
    .subscribe-popup__img-box {
      width: 100%;
      height: 100%;
      z-index: 1;
    }
  
    .subscribe-popup__img {
      width: 100%;
      border-radius: 1.0666666666666vw 1.0666666666666vw 0 0;
      overflow: hidden;
    }
  
    .subscribe-popup__img.is-mb {
      display: block;
    }
  
    .subscribe-popup__img.is-pc {
      display: none;
    }
  
    .subscribe-popup__content {
      width: 100%;
      height: auto;
      position: relative;
      background: #fff;
      padding: 20px;
      border-radius: 0 0 1.0666666666666vw 1.0666666666666vw;
      text-align: center;
      padding: 8vw 5.3333333333333vw 8.93333333333333vw;
      z-index: 1;

      position: absolute;
      z-index: 2;
      top: 0;
      padding-top: 18vh;
      background: unset;
    }
  
    .subscribe-popup__close {
      position: absolute;
      top: 10px;
      right: 10px;
      cursor: pointer;
    }
  
    .subscribe-popup__title {
      font-size: 7.46666666666666vw;
      font-weight: bold;
      line-height: 9.33333333333333vw;
      color: #1E1E1E;
      text-align: center;
    }
  
    .subscribe-popup__title .highlights {
      font-size: 7.46666666666666vw;
      font-weight: bold;
      line-height: 9.33333333333333vw;
      color: #1270B3;
    }
  
    .subscribe-popup__desc {
      color: #1E1E1E;
      font-size: 3.73333333333333vw;
      line-height: 5.33333333333333vw;
      margin-top: 1.733333333333vw;
    }
  
