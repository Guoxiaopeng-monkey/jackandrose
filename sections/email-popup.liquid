      font-size: 3.2vw;
      border: 1px solid rgb(30, 30, 30, 0.2);
      width: 100%;
      height: 11.7333333333333vw;
      line-height: 11.7333333333333vw;
      flex-shrink: 0;
      padding-left: 3.2vw;
    }
  
    .subscribe-popup__btn {
      width: 13%;
      height: 78%;
      flex-shrink: 0;
      color: #000;
      text-align: center;
      font-size: 4vw;
