  </style>

  <div class="subscribe-popup" data-delay="{{ section.settings.delay }}" data-test-mode="{{ request.design_mode }}">
    <div class="subscribe-popup__overlay"></div>
    <div class="subscribe-popup-box">
        <div class="subscribe-popup-box-close">
          {{ icon_close }}
        </div>
      <div class="subscribe-popup__content">
        <div class="subscribe-popup__title">{{ section.settings.title }}</div>
        <div class="subscribe-popup__desc">{{ section.settings.description }}</div>

        {%- form 'customer', id: 'subscribePopup', class: 'subscribe-popup-form' -%}
          {%- unless form.posted_successfully? -%}
            <div class="inpBut">
              <input
                type="text"
                name="contact[email]"
                autocomplete="off"
                placeholder="{{ section.settings.placeholder }}"
                class="subscribe-popup__email"
              >
              <div class="subscribe-popup__btn">
               <svg viewBox="0 0 20 20" fill="currentColor" stroke="currentColor" class="absolute right-5 top-[18px] h-5 w-5 text-gray"><path d="M1.7 10c0-3.1 0-4.7 1-5.7s2.5-1 5.6-1h3.4c3.1 0 4.7 0 5.7 1s1 2.6 1 5.7 0 4.7-1 5.7-2.6 1-5.7 1H8.3c-3.1 0-4.7 0-5.7-1s-1-2.6-1-5.7Z" fill="none" stroke-opacity="0.3" stroke-width="1.6"></path><path d="m5 6.7 1.8 1.5Q8.8 10 10 10c1 0 1.7-.7 3.2-2L15 6.8" fill="none" stroke-opacity="0.3" stroke-width="1.6" stroke-linecap="round"></path></svg>
              </div>
            </div>
            <button type="submit" class="subscribe-popup__button"> {{ section.settings.button_text | default:'Subscribe' }} </button>
        {%- endunless -%}

          {%- if form.errors -%}
            <div class="el-form-item__error">
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </div>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <h3
              class="subscribe-popup-form__message--success"
              tabindex="-1"
            >
              {{icon_success}}
              Thanks for subscribing
            </h3> 
          {%- endif -%}
        {%- endform -%}
        {% if section.settings.tips != blank %}
          <span class="subscribe-popup_tips">{{ section.settings.tips }}</span>
        {% endif %}
        {% if section.settings.footer != blank %}
          <div class="subscribe-popup_footer">
            {{ section.settings.footer }}
          </div>
        {% endif %}
      </div>
      <div class="subscribe-popup__img-box">
        <img
          class="subscribe-popup__img is-pc"
          src="{{ section.settings.image_pc | image_url: width: 620 }}"
          width="310"
          height="310"
        >
        <img
          class="subscribe-popup__img is-mb"
          src="{{ section.settings.image_mb | image_url: width: 1200 }}"
          width="624"
          height="624"
        >
      </div>
    </div>
  </div>
{% endif %}
<script>
  document.addEventListener("DOMContentLoaded", function () {

    const cookieName = "subscribe-popup";
    const cookieValue = "true";
    const cookieDays = {{section.settings.day}};

    if (!getCookie(cookieName)) {
        const popup = document.querySelector(".subscribe-popup");
        if (popup && !popup.classList.contains('active')) {
            const timeout = popup.dataset.delay
            setTimeout(function () {
              popup.classList.add("active")
            }, timeout)
        }

        setCookie(cookieName, cookieValue, cookieDays);
    }
    
  
  
    document.querySelector(".subscribe-popup-box-close").addEventListener("click", function (e) {
      const el = e.target.closest(".subscribe-popup")
      el.classList.remove("active")
    })

  function setCookie(name, value, days) {
      var expires = "";
      if (days) {
          var date = new Date();
          date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
          expires = "; expires=" + date.toUTCString();
      }
      document.cookie = name + "=" + (value || "") + expires + "; path=/";
  }
  
  function getCookie(name) {
      var nameEQ = name + "=";
      var ca = document.cookie.split(';');
      for (var i = 0; i < ca.length; i++) {
          var c = ca[i];
          while (c.charAt(0) === ' ') c = c.substring(1, c.length); 
          if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
      }
      return null; 
  }
  })
</script>
{% schema %}
{
  "name": "Subscribe Popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable Subscribe Popup",
      "default": false
    },
    {
      "type": "number",
      "id": "day",
      "label": "*Expires (day)",
      "default": 7
    },
    {
      "type": "number",
      "id": "delay",
      "label": "Delay (seconds)",
      "default": 5000
    },
    {
      "type": "image_picker",
      "id": "image_pc",
      "label": "Image for PC"
    },
    {
      "type": "image_picker",
      "id": "image_mb",
      "label": "Image for Mobile"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "html",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "html",
      "id": "button_text",
      "label": "Button"
    },
    {
      "type": "html",
      "id": "placeholder",
      "label": "Placeholder"
    },
    {
      "type": "text",
      "id": "tips",
      "label": "Tips",
      "default":"*Cannot be combined with other promo codes."
    },
    {
      "type": "richtext",
      "id": "footer",
      "label": "Footer infomation"
    }
  ],
    "presets": [
      {
        "name": "subscribe-popup"
      }
    ]
}
{% endschema %}
