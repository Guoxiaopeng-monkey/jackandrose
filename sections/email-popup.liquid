    padding: 44px 21px 21px;
  }
  
  .subscribe-popup__close {
    position: absolute;
    top: 10px;
    right: 10px;
    cursor: pointer;
  }
  
  .subscribe-popup__title {
    font-size: 32px;
    font-weight: bold;
    line-height: 44px;
    color: #1E1E1E;
    text-align: center;
  }
  
  .subscribe-popup__title .highlights {
    font-size: 36px;
    font-weight: bold;
    line-height: 44px;
    color: #1270B3;
  }
  
  .subscribe-popup__desc {
    color: #555555;
    font-size: 16px;
    line-height: 24px;
    margin-top: 13px;
    text-align: center;
  }
  
  .subscribe-popup__desc .highlights {
