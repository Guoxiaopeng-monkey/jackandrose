{% schema %}
  {
    "name": "Icons",
    "settings": [
       {
        "type": "header",
        "content": "Padding"
      },
      {
            "type": "text",
            "id": "padding_pc",
            "label": "Padding (desktop)",
            "default":"100px 0"
          },
      {
            "type": "text",
            "id": "padding_m",
            "label": "Padding (mobile)",
            "default":"80px 0"
          }
    ],
    "blocks": [
      {
        "type": "icon",
        "name": "icon",
        "settings": [
          {
            "type": "select",
            "id": "liquid",
            "label": "Icon",
            "default":"1",
            "options": [
              {
                "label": "1",
                "value": "1"
              },
              {
                "label": "2",
                "value": "2"
              },
              {
                "label": "3",
                "value": "3"
              },
              {
                "label": "4",
                "value": "4"
              }
            ]
          },
          {
            "type": "text",
            "id": "title",
            "label": "Heading",
            "default": "Fast & Free Shipping"
          },
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default":"Price includes shipping, free "
          }
        ]
      }
    ],
    "presets": [
        {
            "name": "Icons",
            "blocks": [
                {
                  "type": "icon"
                },
                {
                  "type": "icon"
                },
                {
                  "type": "icon"
                }
            ]
        }
    ]
  }
{% endschema %}