
<style>
 
  .inbox-container {
      width:100%;
    background: linear-gradient(to bottom, #dddddd,#ffffff ); 
    padding:80px 0 60px;
  }
    .inbox-items-wrapper {
    display: flex;  
    align-items: center;  
    justify-content: center;  
  
  }
  .left-column {
    flex: 1;  
    padding-right: 20px;  
  }
  .right-column {
    flex: 1; 
    display: flex;
    justify-content: center; 
    align-items: center; 
  }
  img {
    max-width: 100%;  
    height: auto;
  }
  @media(max-width:768px){
      .inbox-container {
      width:100%; 
    padding:40px 0 30px;
      }
     .inbox-items-wrapper {
       width:100%; flex-direction:column;
     }
    .right-column{order:1; margin-bottom:20px;  width:100%}
   .left-column{order:2;width:100%}
  }
</style>
<section class="inbox-container product-section">
<div class="page-width inbox-items-wrapper">
  <div class="left-column">
      {%- if section.settings.title != blank -%}
 
      <h2>{{ section.settings.title }}</h2>
  
  {%- endif -%}
    <ul>
          {%- for block in section.blocks -%}
              <li>{{ block.settings.item }}</li>
         {%- endfor -%}
 
            
    </ul>
  </div>
  <div class="right-column">
   {% if section.settings.image != blank %} <img src="{{ section.settings.image | image_url:  width: 720 }}"  class="image" />{% endif %}
     
  </div>
</div>
 
</section> 
{% schema %}
  {
    "name": "custom inbox items",
    "class": "inbox-items-section",
    "settings": [
      {
		"type": "select",
		"id": "colors",
		"label": "Color scheme",
		"default": "light",
		"options": [
			{
				"value": "light",
				"label": "Light"
			},
			{
				"value": "accent",
				"label": "Feature"
			},
			{
				"value": "dark",
				"label": "Dark"
			}
		]
	  },
         {
        "type": "text",
        "id": "title",
        "label": "Heading"
      },
        {
        "type": "image_picker",
            "id": "image",
            "label": "inbox Image"
          }
     ],
    "blocks": [
      {
        "type": "text_column",
        "name": "Inbox item",
        "settings": [
          {
            "type": "text",
            "id": "item",
            "label": "Inbox item" 
          }
         
        ]
      }
    ],
    "presets": [
      {
        "name": "Custom inbox items"
      }
    ]
  }
{% endschema %}