{% assign sid = section.id %}
<style>
    #shopify-section-{{ sid }} .index-banner{
      position:relative;
    }
    #shopify-section-{{ sid }} .index-banner::before{
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      z-index: 1;
      width: 100%;
      height: 100%;
      background: #000;
      opacity:{{section.settings.overlayer | divided_by:100.0}};
    }
    #shopify-section-{{ sid }} .index-banner .page-width{
      --page-width:1360px;
      width: 100%;
      height: 100%;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      flex-direction: column;
      color:#fff;
    }
    #shopify-section-{{ sid }} .index-banner img{
      width:100%;
      height:auto;
      display:block;
    }
    #shopify-section-{{ sid }} .index-banner .content{
      position:absolute;
      top:0;
      left:0;
      z-index:2;
      width:100%;
      height:100%;
    }
    #shopify-section-{{ sid }} .index-banner .content__box{
      max-width:800px;
    }
    #shopify-section-{{ sid }} .index-banner .content .banner-title{
      font-size: 56px;
      font-weight: 500;
      line-height: 78px;
      margin-bottom: 12px;
    }
    #shopify-section-{{ sid }} .index-banner .content .banner-text{
      font-size: 20px;
      font-weight: 400;
      line-height: 28px;
      margin-bottom:24px;
      opacity:0.8;
    }
    #shopify-section-{{ sid }} .index-banner .content .banner-btn{
      color: #000;
      font-size: 16px;
      font-weight: 500;
      line-height: 1.4; 
      background:#FFF;
      border-radius: 8px;
      padding:8px 20px;
      display:inline-block;
    }
    #shopify-section-{{ sid }} .index-banner .content .banner-btn:hover{
      background: #F47C20;
      color: #fff;
    }
  @media (max-width:959px){
    .index-banner{
      margin: 0 16px;
      border-radius: 24px;
      overflow: hidden;
    }
    #shopify-section-{{ sid }} .index-banner .page-width{
      justify-content: flex-end;
    }
    #shopify-section-{{ sid }} .index-banner .content__box{
      max-width:320px;
      padding-bottom:24px;
    }
    #shopify-section-{{ sid }} .index-banner .content .banner-title{
      font-size: 28px;
      font-weight: 500;
      line-height: 39px;
      margin-bottom: 8px;
    }
    #shopify-section-{{ sid }} .index-banner .content .banner-text{
      font-size: 14px;
      line-height: 19px;
      margin-bottom:12px;
    }
    #shopify-section-{{ sid }} .index-banner .content .banner-btn{
      font-size: 14px;
      line-height: 19px;
      padding:6px 12px;
    }
  }
</style>
<div class="index-banner">
  {% liquid
        assign pc_image = section.settings.img
        assign mobile_image = section.settings.img_m
        assign alt = section.settings.img.alt
    %}
    
    <picture>
        <source srcset="{{ mobile_image | img_url: '750x' }}"
                media="(max-width: 375px)">
        <source srcset="{{ mobile_image | img_url: '1536x' }}"
                media="(max-width: 768px)">
        <source srcset="{{ pc_image | img_url: '2160x' }}"
                media="(max-width: 1080px)">
        <source srcset="{{ pc_image | img_url: '2400x' }}"
                media="(max-width: 1200px)">
        <source srcset="{{ pc_image | img_url: '3840x' }}"
                media="(max-width: 1920px)">
        <img src="{{ pc_image | img_url: '3840x' }}" alt="{{ alt }}" loading="lazy" width="auto" height="100%">
    </picture>
    <div class="content">
      <div class="page-width">
        <div class="content__box">
          {% if section.settings.title != blank %}
            <div class="banner-title">{{ section.settings.title }}</div>
          {% endif %}
          {% if section.settings.text != blank %}
            <div class="banner-text">{{ section.settings.text }}</div>
          {% endif %}
          {% if section.settings.btn != blank %}
            <a class="banner-btn" href="{{ section.settings.link }}">{{ section.settings.btn }}</a>
          {% endif %}
        </div>
      </div>
    </div>
</div>

{% schema %}
  {
    "name": "Home banner",
    "settings": [
      {
        "type": "image_picker",
        "id": "img",
        "label": "image (desktop)"
      },
      {
        "type": "image_picker",
        "id": "img_m",
        "label": "image (mobile)"
      },
      {
        "type": "range",
        "id":"overlayer",
        "label": "Overlayer opacity",
        "max": 100,
        "min": 1,
        "step": 1,
        "default":30
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title"
      },
      {
        "type": "text",
        "id": "text",
        "label": "Text"
      },
      {
        "type": "text",
        "id": "btn",
        "label": "Button"
      },
      {
        "type": "url",
        "id": "link",
        "label": "link"
      }
    ],
    "presets": [
      {
        "name": "Home banner"
      }
    ]
  }
{% endschema %}