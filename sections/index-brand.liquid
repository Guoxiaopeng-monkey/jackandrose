<style>
  #shopify-section-{{ section.id }} .page-width{
      --page-width:1360px;
  }
  .template-index .page-width{
    max-width: 1360px;
  }
  .home-brand {
    padding-top: 0px;
    padding-bottom: 80px;
    overflow: hidden;
  }
  .home-brand .item{
    position: relative;
  }
  .home-brand .item .content-box{
    position: absolute;
    top:0;
    left:0;
    bottom:0;
    right: 0;
    width: 100%;
    height: 100%;
    padding: 30px;
  }
  .home-brand .item-title{
    color: #fff;
    font-size: 20px;
    font-weight: 500;
    line-height: 28px;
    margin-bottom: 8px;
  }
  .home-brand .item-text{
    color: rgba(255, 255, 255, 0.80);
    font-size: 14px;
    font-weight: 400;
    line-height: 22px;
    margin-bottom: 0px;
  }
  .home-brand img{
    border-radius: 24px;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .home-brand .wrapper{
    display: flex;
    gap: 20px;
  }
  .home-brand .wrapper .left-box{
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    width: calc(75% - 10px);
  }
  .home-brand .wrapper .right-box{
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    width: calc(25% - 10px);
  }
  .home-brand .wrapper .left-box .item-0{
    width: 100%;
    padding-bottom: 300px;
  }
  .home-brand .wrapper .left-box .item-0 img{
    width: 100%;
    height: 100%;
    transform-origin: top;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 999;
  }
  .home-brand .wrapper .left-box .item-1,
  .home-brand .wrapper .left-box .item-2{
    width: calc((100% - 20px)/2);
  }
  .home-brand .wrapper .right-box .item{
    width: 100%;
  }
  #shopify-section-{{ section.id }} .product-section-info{
      margin-bottom:40px;
    opacity:0;
    }
    #shopify-section-{{ section.id }} .product-section-title{
      color: #000;
      font-size: 36px;
      font-weight: 500;
      line-height: 1.4;
    }
   @media (min-width: 991px) and (max-width: 1500px){
     .home-brand .item .content-box{padding:20px;}
     .home-brand .item-title{font-size:18px;}
   }
   @media (max-width: 990px){
     .home-brand{
       padding-top: 0px;
       padding-bottom: 30px;
     }
     #shopify-section-{{ section.id }} .product-section-info{
      margin-bottom:24px;
    }
    #shopify-section-{{ section.id }} .product-section-title{
      font-size: 20px;
    }
     .home-brand .wrapper{
       gap: 12px;
       flex-wrap: wrap;
     }
     .home-brand .wrapper .left-box{
       gap: 12px;
       width: 100%;
     }
     .home-brand .wrapper .right-box{
       gap: 12px;
       width: 100%;
     }
     .home-brand .wrapper .left-box .item-1,
     .home-brand .wrapper .left-box .item-2,
     .home-brand .wrapper .right-box .item{
       width: calc(50% - 6px);
     }
     .home-brand .item .content-box{
       padding: 16px;
     }
     .home-brand .item-title{
        color: #0D0D0D;
        font-size: 14px;
        font-weight: 500;
        line-height: 19.6px;
         margin-bottom: 4px;
      }
      .home-brand .item-text{
        color: rgba(0, 0, 0, 0.80);
        font-size: 12px;
        font-weight: 400;
        line-height: 16px;
        margin-bottom: 0px;
      }
  }
</style>


<div class="page-width starter">
  <div class="product-section-info">
      {% if section.settings.title != blank %}
        <div class="product-section-title">{{ section.settings.title }}</div>
      {% endif %}
    </div>
  <div class="wrapper">
    <div class="left-box">
      {% for block in section.blocks limit: 3 %}
        <div class="item item-{{ forloop.index0 }}">
          <a href="{{ block.settings.link }}">
            {% if block.settings.img != blank %}
              <picture>
                <source
                  srcset="{{ block.settings.img_m | img_url:'master' }}"
                  media="(max-width: 990px)"
                >
                <img
                  src="{{ block.settings.img | img_url:'master' }}"
                  alt=""
                  loading="lazy"
                  width="100%"
                  height="auto"
                >
              </picture>  
            {% endif %}
            <div class="content-box">
                {% if block.settings.title != blank %}
                  <h2 class="item-title">{{ block.settings.title }}</h2>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="item-text">{{ block.settings.text }}</p>
                {% endif %}
            </div>
            
          </a>
        </div>
      {% endfor %}
    </div>
    <div class="right-box">
      {% for block in section.blocks %}
        {% if forloop.index0 > 2 %}
          <div class="item item-{{ forloop.index0 }}">
          <a href="{{ block.settings.link }}">
            {% if block.settings.img != blank %}
              <picture>
                <source
                  srcset="{{ block.settings.img_m | img_url:'master' }}"
                  media="(max-width: 990px)"
                >
                <img
                  src="{{ block.settings.img | img_url:'master' }}"
                  alt=""
                  loading="lazy"
                  width="100%"
                  height="auto"
                >
              </picture>  
            {% endif %}
            <div class="content-box">
                {% if block.settings.title != blank %}
                  <h2 class="item-title">{{ block.settings.title }}</h2>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="item-text">{{ block.settings.text }}</p>
                {% endif %}
            </div>
          </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", (event) => {

      let title =$('#shopify-section-{{ section.id }} .product-section-info');
      
      ScrollTrigger.create({
        trigger: '.home-brand .starter',
        start: 'top-=150 top',
        end: '+=1000',
        markers: false,
        pin: true,
        scrub: 0.1,
        animation:
          gsap.timeline()
            .fromTo('.home-brand .wrapper .left-box .item-0 img',{ scale: '4' },{ scale: '1' })
            .fromTo('.home-brand .wrapper .item:not(.item-0)',{ opacity: '0' },{ opacity: '1' })
            .to(title,{opacity: '1'}, "<")
      })
    });
              
</script>

{% schema %}
  {
    "name": "Home brand",
    "class": "home-brand",
    "max_blocks": 5,
    "limit": 1,
    "tag": "section",
    "disabled_on": {
      "groups": ["footer","header"]
    },
    "settings": [
      {
            "type": "text",
            "id": "title",
            "label": "Heading",
            "default": "TOP"
          },
    ],
    "blocks": [
      {
        "type": "block",
        "name": "block",
        "settings": [
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          },
          {
            "type": "image_picker",
            "id": "img",
            "label": "Image(desktop)"
          },
          {
            "type": "image_picker",
            "id": "img_m",
            "label": "Image(mobile)"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Fast & Free Shipping"
          },
          {
            "type": "textarea",
            "id": "text",
            "label": "Text",
            "default": "Price includes shipping, free"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Home brand"
      }
    ]
  }
{% endschema %}