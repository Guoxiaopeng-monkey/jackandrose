<style>
  #shopify-section-{{ section.id }} .page-width{
      --page-width:1360px;
  }
  .template-index .page-width{
    max-width: 1360px;
  }
  .home-rewards {
    padding-bottom: 80px;
  }
  .home-rewards .section_title{
    color: #000;
    font-weight: 500;
    font-size: 36px;
    line-height: 1.4;
    text-transform: capitalize;
    text-align: left;
    margin-bottom: 40px;
  }
  .home-rewards .wrapper{
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }
  .home-rewards .wrapper .item{
    padding: 48px 24px;
    border-radius: 24px;
    background: rgba(244, 124, 32, 0.10);
    box-shadow: 0px 6px 20px 0px rgba(0, 0, 0, 0.10);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
        width: calc((100% - 20px*{{section.blocks.size | minus:1}}) / {{section.blocks.size}});
  }
  .home-rewards .wrapper .item picture{
    margin: 36px auto 40px;
  }
  .home-rewards .wrapper .item img{
    width: 100px;
    height: 100px;
    object-fit: cover;
  }
  .home-rewards .wrapper .item-title{
    color: #000;
    text-align: center;
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
    text-transform: capitalize;
    margin-bottom: 8px;
  }
  .home-rewards .wrapper .item-text{
    color: rgba(0, 0, 0, 0.80);
    text-align: center;
    font-size: 16px;
    font-weight: 400;
    line-height: 22.4px;
    text-transform: capitalize;
    margin-bottom: 0px;
  }
  .home-rewards .wrapper .item-url{
    color: #000;
    text-align: center;
    font-size: 16px;
    font-weight: 600;
    line-height: 22.4px;
    text-transform: capitalize;
    display: flex;
    align-items: center;
  }
  .home-rewards .wrapper .item-url svg{
    display: block;
  }
   @media (max-width: 990px){
     .home-rewards{
       padding-bottom: 40px;
     }
     .home-rewards .section_title{
      font-size: 20px;
      text-align: left;
      margin-bottom: 24px;
    }
    .home-rewards .wrapper{
      flex-wrap: nowrap;
      gap: 12px;
      overflow-x: auto;
    }
    .home-rewards .wrapper .item{
      /* width: calc((100% - 12px) / 2); */
      width: 68%;
      min-height: 300px;
      padding: 12px;
      flex-shrink: 0;
    }
     .home-rewards .wrapper .item picture{
      margin: 12px auto 24px;
    }
     .home-rewards .wrapper .item-title{
      font-size: 16px;
      line-height: 20px;
    }
    .home-rewards .wrapper .item-text{
      font-size: 12px;
      line-height: 16px;
    }
    .home-rewards .wrapper .item-url{
      font-size: 14px;
      line-height: 19px;
    }
     .home-rewards .wrapper .item img{
      width: 60px;
      height: 60px;
    }
  }
</style>


<div class="page-width">
  {% if section.settings.title != blank %}
    <h2 class="section_title">{{ section.settings.title }}</h2>
  {% endif %}
  <div class="wrapper">
    {% for block in section.blocks %}
      <div class="item">
        {% if block.settings.title != blank %}
          <h2 class="item-title">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.text != blank %}
          <p class="item-text">{{ block.settings.text }}</p>
        {% endif %}
        {% if block.settings.image != blank %}
          <picture>
            <source
              srcset="{{ block.settings.image_m | img_url:'master' }}"
              media="(max-width: 990px)"
            >
            <img
              src="{{ block.settings.image | img_url:'master' }}"
              alt=""
              loading="lazy"
              width="100%"
              height="auto"
            >
          </picture>  
        {% endif %}
        {% if block.settings.btn_text != blank and block.settings.url != blank %}
          <a class="item-url" href="{{ block.settings.url }}">
            {{ block.settings.btn_text }}
            <span>
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7.37421 13.575L11.9492 9L7.37421 4.42499" stroke="black" stroke-width="1.5"/>
              </svg>
            </span>
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
  {
    "name": "Home rewards",
    "class": "home-rewards",
    "max_blocks": 4,
    "limit": 1,
    "tag": "section",
    "disabled_on": {
      "groups": ["footer","header"]
    },
    "settings": [
      
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Perk and Rewards"
      }
    ],
    "blocks": [
      {
        "type": "block",
        "name": "block",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "image_picker",
            "id": "image_m",
            "label": "Image mobile"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "turpis sed sagittis "
          },
          {
            "type": "textarea",
            "id": "text",
            "label": "Text",
            "default": "Lorem ipsum dolor sit amet consectetur. Nulla dictumst massa natoque pulvinar pellentesque. "
          },
          {
            "type": "text",
            "id": "btn_text",
            "label": "Button text",
            "default": "Learn More"
          },
          {
            "type": "url",
            "id": "url",
            "label": "Button url"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Home rewards"
      }
    ]
  }
{% endschema %}