  }

  img,
  svg,
  video,
  canvas,
  audio,
  iframe,
  embed,
  object {
    display: block;
    vertical-align: middle
  }

  img,
  video {
    max-width: 100%;
    height: auto
  }

  [hidden]:where(:not([hidden=until-found])) {
    display: none
  }

  .fixed {
    position: fixed
  }

  .absolute {
    position: absolute
  }

  .relative {
    position: relative
  }

  .inset-0 {
    top: 0;
    right: 0;
    bottom: 0;
    left: 0
  }

  .mx-auto {
