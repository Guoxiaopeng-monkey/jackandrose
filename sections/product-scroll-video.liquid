{% assign sid = section.id %}
<style>
  .scroll-video{
    position: relative;
    {% if section.settings.img != blank %}
    min-height: 100vh;
      {% endif %}
  }
  .scroll-video .post-video{
    position: relative;
    height: 100%;
    /* max-height: 1470px; */
  }
  .scroll-video .post-video .video-box{
    width: 100%;
    height: 100%;
    display:block;
  }
  .scroll-video .post-video .video-box .post-player{
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .scroll-video .content-box{
    position: absolute;
    top: 50%;
    left: 50%;
    transform:translate(-50%,-50%);
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: rgba(0,0,0,.3);
    {% if section.settings.img != blank %}
    opacity: 0;
    z-index: 2;
    {% else %}
    z-index: 4;
    {% endif %}
  }
  .scroll-video .content-box .wrapper{
    color: #fff;
    text-align: center;
    width: 60%;
  }
  .scroll-video .content-box .wrapper .title{
    font-size: 56px;
    font-weight: 500;
    line-height: 1.4;
    margin-bottom: 12px;
  }
  .scroll-video .content-box .wrapper .text{
    font-size: 20px;
    line-height: 1.2;
    margin-bottom: 30px;
  }
  .scroll-video .content-box .wrapper .open-video{
    font-size: 16px;
    line-height: 1.4;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid #fff;
    display: flex;
    width: fit-content;
    gap: 4px;
    margin: 0 auto;
    padding: 12px 20px;
    cursor: pointer;
    align-items: center;
  }
  .scroll-video .content-box .wrapper .open-video svg{
    display:block;
  }
  .scroll-video .content-box .wrapper .open-video:hover{
    background: rgba(255, 255, 255, .3);
  }
  .scroll-video .scroll-banner{
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    z-index:3;
  }
  .scroll-video .scroll-banner picture{
    width: 100%;
    height: 100%;
  }
  .scroll-video .scroll-banner img{
    width: 100%;
    height: 100%;
    display:block;
    object-fit: cover;
  }
  .main-video{
    position: fixed;
    display: none;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: #111111d4;
    justify-content: center;
    align-items: center;
    z-index: 999999;
  }
  #main-player{
    width: 840px;
    max-width: 840px;
    position: relative;
  }
  #main-player video{
    width:100%;
  }
  .main-video .close-btn{
    position: absolute;
    width: 40px;
    height: 40px;
    cursor: pointer;
    top: calc(50vh - 300px);
    right: calc(50vw - 500px);
    opacity: .3;
  }
  .main-video .close-btn:hover{
    opacity: 1;
  }
  @media only screen and (max-width: 1000px){
    .main-video .close-btn{
      top: 8%;
      right: 8%;
    }
    .main-video .close-btn{
      opacity: 1;
    }
  }
  @media only screen and (min-width: 769px){
    .scroll-video .post-video .video-box .post-player.mobile{
      display:none;
    }
  }
  @media only screen and (max-width: 768px){
    .scroll-video .post-video .video-box .post-player.desktop{
      display:none;
    }
    .scroll-video .content-box .wrapper{
      width: 75%;
    }
    .scroll-video .content-box .wrapper .title{
      font-size: 28px;
    }
    .scroll-video .content-box .wrapper .text{
      font-size: 14px;
      line-height: 1.4;
      margin-bottom: 24px;
    }
    .scroll-video .content-box .wrapper .open-video{
      padding:10px 20px;
    }
  }
</style>

<div class="scroll-video" id ="product-scroll-video">
  <div class="post-video">
    <div class="video-box">
      <!-- <video id="post-player" class="post-player" playsinline muted autoplay loop>
        <source src="{{ section.settings.post_video }}" type="video/mp4" />
        <source src="{{ section.settings.post_video }}" type="video/webm" />
      </video> -->
      <video
            id="post-player"
            class="post-player desktop"
            src="{{ section.settings.post_video.sources[1].url }}"
            data-type="mp4"
            muted
            playsinline
            autoplay
            loop
          ></video>
      <video
            id="post-player"
            class="post-player mobile"
            src="{{ section.settings.post_video_m.sources[1].url }}"
            data-type="mp4"
            muted
            playsinline
            autoplay
            loop
          ></video>
    </div>
    <div class="content-box">
      <div class="wrapper">
        {% if section.settings.text != blank %}
          <p class="title">{{ section.settings.title }}</p>  
        {% endif %}
        {% if section.settings.text != blank %}
          <p class="text">{{ section.settings.text }}</p>  
        {% endif %}
        {% if section.settings.main_video != blank and section.settings.btn_name != blank %}
          <div class="open-video">
            <span style="margin-right:4px;">{{ section.settings.btn_name }}</span>
            <span><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 20C15.5228 20 20 15.5228 20 10C20 4.47715 15.5228 0 10 0C4.47715 0 0 4.47715 0 10C0 15.5228 4.47715 20 10 20ZM8.25007 13.8971L14.2501 10.433C14.5834 10.2406 14.5834 9.75944 14.2501 9.56699L8.25007 6.10289C7.91674 5.91044 7.50007 6.151 7.50007 6.5359V13.4641C7.50007 13.849 7.91674 14.0896 8.25007 13.8971Z" fill="currentColor"/></svg></span>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
              {% if section.settings.img != blank %}
  <div class="scroll-banner">
    {% liquid
          assign pc_image = section.settings.img
          assign mobile_image = section.settings.img_m
          assign alt = section.settings.img.alt
        %}

        <picture>
          <source
            srcset="{{ mobile_image | img_url: '750x' }}"
            media="(max-width: 375px)"
          >
          <source
            srcset="{{ mobile_image | img_url: '1536x' }}"
            media="(max-width: 589px)"
          >
          <source
            srcset="{{ pc_image | img_url: '2160x' }}"
            media="(max-width: 1080px)"
          >
          <source
            srcset="{{ pc_image | img_url: '2400x' }}"
            media="(max-width: 1200px)"
          >
          <source
            srcset="{{ pc_image | img_url: '3840x' }}"
            media="(max-width: 1920px)"
          >
          <img
            class=""
            src="{{ pc_image | img_url: '3840x' }}"
            alt="{{ alt }}"
            loading="lazy"
            width="auto"
            height="100%"
          >
        </picture>
  </div>
                {% endif %}
</div>

<div id="main-video" class="main-video">
  <svg stroke="#fff" fill="#fff" stroke-width="0" viewBox="0 0 512 512" class="close-btn" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M256 48C140.559 48 48 140.559 48 256c0 115.436 92.559 208 208 208 115.435 0 208-92.564 208-208 0-115.441-92.564-208-208-208zm104.002 282.881l-29.12 29.117L256 285.117l-74.881 74.881-29.121-29.117L226.881 256l-74.883-74.881 29.121-29.116L256 226.881l74.881-74.878 29.12 29.116L285.119 256l74.883 74.881z"></path></svg>
  <div class="plyr__video-embed" id="main-player">
    <video src data-src="{{ section.settings.main_video.sources[1].url }}" data-type="mp4" controls></video>
  </div>
</div>

<script>

  document.addEventListener('DOMContentLoaded', function () {
              {% if section.settings.img != blank %}
    
    gsap.registerPlugin(ScrollTrigger);
    let t1;
    const container = $('#shopify-section-{{ sid }} .scroll-video');
    const banner = $('#shopify-section-{{ sid }} .scroll-banner img');
    const contentBox = $('#shopify-section-{{ sid }} .content-box');
    const endPoint = window.innerHeight*1.5;
    const width = window.innerWidth;

    handleScroll();
    function handleScroll(){
      if(t1) t1.revert();
      t1 = gsap.timeline({
        scrollTrigger:{
          trigger: container,
          start: 'top top',
          end: ()=>`+=${endPoint}`,
          pin: true,
          scrub: true,
          // markers:true,
          invalidateOnRefresh: true,
        }
      });

      t1.to(banner,{
        transform:'scale(4)'
      }).to(
        banner,{
        opacity: 0,
        }
      ).to(
        contentBox,{
        opacity: 1,
        "z-index":4,
        }
      )
    };

    $(window).resize(function() {
      if(t1) {
        t1.revert();
        t1.clear();
      }
      handleScroll();
    });
                {% endif %}
    
 });
    
    $('.open-video').click(function(){
      $('.main-video').css('display','flex');
      // $('html').css('overflow','hidden');
      let src = $('.main-video video').attr('data-src');
      $('.main-video video').attr('src',src);
      $('.main-video video')[0].play()
    })

    $('.main-video .close-btn').click(function(){
      // $('html').css('overflow-y','auto');
      $('.main-video').css('display','none');
      $('.main-video video')[0].pause()
    })
</script>

{% schema %}
  {
    "name": "Scroll video",
    "settings": [
      {
        "type": "header",
        "content": "第一屏"
      },      {
        "type": "image_picker",
        "id": "img",
        "label": "Image pc"
      },
      {
        "type": "image_picker",
        "id": "img_m",
        "label": "Image m"
      },
       {
        "type": "header",
        "content": "第二屏"
      },    
      {
        "type": "textarea",
        "id": "title",
        "label": "Title"
      },
      {
        "type": "textarea",
        "id": "text",
        "label": "Text"
      },
      {
        "type": "text",
        "id": "btn_name",
        "label": "Buttom"
      },
      {
        "type": "video",
        "id": "post_video",
        "label": "主视频"
      },
      {
        "type": "video",
