    font-style: normal;
    font-weight: 500;
    line-height: 1.4;
    color: #000000;
    position: absolute;
    top: 0;
    width: 100%;
    cursor: pointer;
    z-index: 1;
  }

  .dl-highlight0718-h-info-title {
    font-size: 24px;
    font-style: normal;
    font-weight: 400;
    line-height: 140%;

    position: absolute;
    top: 0;
    width: 100%;


    opacity: 0;
  }
    .dl-highlight0718-h-info-title span{
      color: #F47C20;
