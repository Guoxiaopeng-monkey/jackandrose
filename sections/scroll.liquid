<dl-highlight0718-h>
  <div class="dl-highlight0718-h">
    <div class="dl-highlight0718-h-container">
      <div class="dl-highlight0718-h-items page-width">
        {% if section.settings.title != blank or section.settings.text != blank %}
          <div class="product-section-info">
            {% if section.settings.title != blank %}
              <div class="product-section-title">{{ section.settings.title }}</div>
            {% endif %}
            {% if section.settings.text != blank %}
              <div class="product-section-text">{{ section.settings.text }}</div>
            {% endif %}
          </div>
        {% endif %}
        <div class="dl-highlight0718-h-images dl-hidden-mobile">
          {% for block in section.blocks %}
            <div class="dl-highlight0718-h-image {% unless forloop.first %}dl-next{% endunless %}">
              <img
                src="{{ block.settings.image | img_url:'1600x' }}"
                alt=""
                width="1600"
                height="1440"
                class="dl-hidden-mobile"
              >
            </div>
          {% endfor %}
        </div>
        <div class="dl-highlight0718-h-infos-base">
          <div class="dl-highlight0718-h-infos" data-dl-active-index="0">
            {% for block in section.blocks %}
              <div class="dl-highlight0718-h-info {% if forloop.first %}dl-active{% endif %}">
                <div class="dl-highlight0718-h-info-bg dl-hidden-desktop">
                  <img src="{{ block.settings.image | img_url:'560x' }}" alt="" width="560" height="688">
                </div>
                <div class="dl-highlight0718-h-info-container">
                  <div class="dl-highlight0718-h-info-subtitle" data-dl-index="{{ forloop.index0 }}">
                    {{ block.settings.title }}
                  </div>
                  <div class="dl-highlight0718-h-info-title">{{ block.settings.text }}</div>
                  <div class="dl-highlight0718-h-info-desc">{{ block.settings.subtext }}</div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
        {% if section.settings.circle != blank %}
          <div class="circle dl-hidden-mobile">
            <img class="" src="{{ section.settings.circle | img_url:'master' }}">
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</dl-highlight0718-h>
<div class="scroll-swiper">
  {% if section.settings.title != blank or section.settings.text != blank %}
    <div class="product-section-info">
      {% if section.settings.title != blank %}
        <div class="product-section-title">{{ section.settings.title }}</div>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="product-section-text">{{ section.settings.text }}</div>
      {% endif %}
    </div>
  {% endif %}
  <div class="swiper custom-scroll-swiper" style="position:relative;">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="item swiper-slide">
          <div class="item-img">
            <img src="{{ block.settings.image | img_url:'560x' }}" alt="" width="560" height="688">
          </div>
        </div>
      {% endfor %}
    </div>
    {% comment %} <div class="scroll_controls"> {% endcomment %}
      <div class="swiper-button-prev scroll_prev">
        <svg
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24px"
          height="24px"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"></path>
        </svg>
      </div>
      <div class="swiper-button-next scroll_next">
        <svg
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24px"
          height="24px"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
        </svg>
      </div>
    {% comment %} </div> {% endcomment %}
  </div>

  <div class="swiper custom-scroll-swiper-bottom">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="item swiper-slide">
          <div class="item-info">
            <div class="info-subtitle">{{ block.settings.title }}</div>
            <div class="info-title">{{ block.settings.text }}</div>
            <div class="info-desc">{{ block.settings.subtext }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="swiper-pagination"></div>
  </div>
</div>
<script src="{{ 'product-scroll.js' | asset_url }}" defer="defer"></script>
<script>
  let cards_swiper = null;
  let cards_swiper2 = null;
  document.addEventListener('DOMContentLoaded', (event) => {
    if ($(window).width() < 990) {
      initCardSwiper();
    }

    $(window).resize(function () {
      initCardSwiper();
    });
  });

  function initCardSwiper() {
    if (cards_swiper && cards_swiper2) {
      cards_swiper.destroy(true, true); // 销毁并清除DOM
      cards_swiper2.destroy(true, true); // 销毁并清除DOM
      cards_swiper = null;
      cards_swiper2 = null;
    }
    cards_swiper = new Swiper('.custom-scroll-swiper', {
      slidesPerView: 1,
      loop: false,
      spaceBetween: 12,
      navigation: {
        nextEl: '.custom-scroll-swiper .swiper-button-next',
        prevEl: '.custom-scroll-swiper .swiper-button-prev',
      },
      breakpoints: {
        591: {
          //当屏幕宽度大于等于590
          slidesPerView: 2,
          spaceBetween: 20,
        },
      },
    });

    cards_swiper2 = new Swiper('.custom-scroll-swiper-bottom', {
      slidesPerView: 1,
      loop: false,
      spaceBetween: 12,
      controller: {
        control: cards_swiper, //控制Swiper1
      },
      pagination: {
        el: '.custom-scroll-swiper-bottom .swiper-pagination',
        type: 'progressbar',
      },
      breakpoints: {
        591: {
          //当屏幕宽度大于等于590
          slidesPerView: 2,
          spaceBetween: 20,
        },
      },
    });
    cards_swiper.controller.control = cards_swiper2;
    cards_swiper2.controller.control = cards_swiper;
  }
</script>

{% schema %}
{
  "name": "Scroll",
  "class": "images-scroll",
  "max_blocks": 3,
  "limit": 1,
  "tag": "section",
  "disabled_on": {
    "groups": ["footer", "header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Fast & Free Shipping"
    },
    {
      "type": "text",
