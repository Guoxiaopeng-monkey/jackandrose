{% assign sid = section.id %}
<script src="{{ 'glider.min.js' | asset_url }}" defer="defer"></script>

{{ 'os-base.css' | asset_url | stylesheet_tag }}
<style>
    #shopify-section-{{ section.id }} .page-width{
        --page-width:1360px;
    }
    .template-index .page-width{
      max-width: 1360px;
    }
    .dl-highlight0718-h {
    position: relative;
    height: calc(300px * 5 + (100vh - 70px - 80px));
  }
  .scroll-swiper{
    display:none;
  }
  .dl-highlight0718-h-container {
    position: sticky;
    top: calc(70px + 40px);
    background: {{section.settings.color_bg}};
    display: flex;
    align-items: center;
    height: calc(100vh - 70px - 80px);
  }

  .dl-highlight0718-h-items {
    display: flex;
    height: 880px;
    overflow: hidden;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-height: 100%;
    position: relative;
  }
    .circle{
      position: absolute;
      top: 0;
      right: 0;
      max-width: 28vw;
    }

  .dl-highlight0718-h-images {
    position: relative;
    height: 880px;
    max-height: 100%;
  }

  .dl-highlight0718-h-image {
    width: 100%;
    max-width: 100%;
    line-height: 0;
    max-height: 100%;

    position: absolute;
    left: 200px;
    top: 40px;
  }

  .dl-highlight0718-h-image.dl-prev {
    width: 200px;
    height: 200px;
    left: 1200px;
    top: -200px;
    opacity:0;
  }

  .dl-highlight0718-h-image.dl-next {
    height: 200px;
    width: 200px;
    left: 0;
    top: 1080px;
    opacity:0;

  }

  .dl-highlight0718-h-image img {
    width: auto;
    height: 100%;
    object-fit: contain;
  }

  .dl-highlight0718-h-infos-base {
    min-height: 333px;
  }

  .dl-highlight0718-h-infos {
    /* margin-left: 216px; */
    position: relative;
  }
  .dl-highlight0718-h-infos::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    height: 100%;
    background: #E5DAD2;
    border-radius: 4px;
  }
  .dl-highlight0718-h-infos::after {
    content: "";
    position: absolute;
    left: 0;
    width: 4px;
    height: 185px;
    border-radius: 4px;
    background: linear-gradient(180deg, rgba(0,177,210,1) 0%, rgba(255,239,117,1) 100%);
  }

  .dl-highlight0718-h-infos[data-dl-active-index="0"]::after {
    top: 0;
  }

  .dl-highlight0718-h-infos[data-dl-active-index="1"]::after {
    top: 78px;
  }

  .dl-highlight0718-h-infos[data-dl-active-index="2"]::after {
    top: 132px;
  }

  .dl-highlight0718-h-info {
    margin-bottom: 24px;
    height: 34px;
  }

  .dl-highlight0718-h-image,
  .dl-highlight0718-h-info,
  .dl-highlight0718-h-info *,
  .dl-highlight0718-h-infos::after {
    transition-property: all;
    transition-duration: 0.8s;
    transition-timing-function: cubic-bezier(0.38, 0.005, 0.215, 1);
  }

  .dl-highlight0718-h-info-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-left: 24px;
    position: relative;
    width: 480px;
