  transition: opacity 0.3s ease, transform 0.3s ease; /* Add transition */
}


.hotspot-info.visible {
  opacity: 1;
  transform: scale(1);  
}

 
.hotspot-info.hidden {
  opacity: 0;
  transform: scale(0.9);  
}
 .hotspot-info .product-title {
  font-size: 1rem;
  }
.hotspot-info .product-price {
  font-size: 1.1rem;
  font-weight: bold;
  color: #333;
  margin-bottom: 10px;  
}
.hotspot-info img{height:auto;}
