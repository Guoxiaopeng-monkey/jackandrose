 
<script>
document.addEventListener('DOMContentLoaded', function () {
  const hotspots = document.querySelectorAll('.hotspot');
  const hotspotIcons = document.querySelectorAll('.hotspot-icon');
  const isMobile = window.innerWidth <= 768; // Check if the user is on a mobile device

  // Function to hide all info boxes
  function hideAllInfoBoxes() {
    hotspots.forEach(function (hotspot) {
      const infoBox = hotspot.querySelector('.hotspot-info');
      infoBox.classList.remove('visible');
      infoBox.classList.add('hidden');
    });
  }

  function updatePosition() {
    if (!isMobile) return; // Only run this code on mobile devices

    hotspots.forEach(hotspot => {
      const rect = hotspot.getBoundingClientRect();
      const infoBox = hotspot.querySelector('.hotspot-info');
      // Check if hotspot is in viewport
      if (rect.top >= 0 && rect.bottom <= window.innerHeight) {
        // Hotspot is visible, make infoBox fixed
        infoBox.style.position = 'fixed';
        infoBox.style.top = '35%'; 
        infoBox.style.left = '50%';
        infoBox.style.transform = 'translateX(-50%)';
      } else {
        // Hotspot is not visible, make infoBox absolute
        infoBox.style.position = 'absolute';
        infoBox.style.top = '30px';
        infoBox.style.left = '40px';
        infoBox.style.transform = 'none';
      }
    });
  }

  // Adjust the position of each hotspot based on device type
  if (isMobile) {
    // Mobile: Bind click events to hotspot-icons
    hotspotIcons.forEach(function (icon) {
      icon.addEventListener('click', function (event) {
        event.stopPropagation(); // Stop propagation to prevent unwanted page navigation
        event.preventDefault(); // Prevent navigation on link click

        hideAllInfoBoxes();

        const infoBox = icon.closest('.hotspot').querySelector('.hotspot-info');
        if (infoBox.classList.contains('hidden')) {
          infoBox.classList.remove('hidden');
          infoBox.classList.add('visible');
        } else {
          infoBox.classList.remove('visible');
          infoBox.classList.add('hidden');
        }
      });
    });

    // Ensure the info boxes are hidden and position updated on scroll
    window.addEventListener('scroll', function () {
      hideAllInfoBoxes();
      updatePosition();
    });

    // Prevent default link behavior when hotspot icon is clicked
    hotspots.forEach(function (hotspot) {
      hotspot.addEventListener('click', function (event) {
        if (event.target.classList.contains('hotspot-icon') || event.target.closest('.hotspot-icon')) {
          event.preventDefault(); // Prevent link navigation
        }
      });
    });
  } else {
    // Desktop: Handle mouseover events
    hotspots.forEach(function (hotspot) {
      hotspot.addEventListener('mouseover', function () {
        hideAllInfoBoxes();
        const infoBox = hotspot.querySelector('.hotspot-info');
        infoBox.classList.remove('hidden');
        infoBox.classList.add('visible');
      });
    });
  }

  // Click outside hotspots to hide info boxes
  document.addEventListener('click', function (event) {
    if (!event.target.closest('.hotspot-icon')) {
      hideAllInfoBoxes();
    }
  });
});


</script>
 


