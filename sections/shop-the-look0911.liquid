<script>
document.addEventListener('DOMContentLoaded', function () {
  const hotspots = document.querySelectorAll('.hotspot');
  const isMobile = window.innerWidth <= 768; // Check if the user is on a mobile device

  // Function to hide all info boxes
  function hideAllInfoBoxes() {
    hotspots.forEach(function (hotspot) {
      const infoBox = hotspot.querySelector('.hotspot-info');
      infoBox.classList.remove('visible');
      infoBox.classList.add('hidden');
    });
  }

  function updatePosition() {
    if (!isMobile) return;  // Only run this code on mobile devices

    hotspots.forEach(hotspot => {
      const rect = hotspot.getBoundingClientRect();
      const infoBox = hotspot.querySelector('.hotspot-info');
      // Check if hotspot is in viewport
      if (rect.top >= 0 && rect.bottom <= window.innerHeight) {
        // Hotspot is visible, make infoBox fixed
        infoBox.style.position = 'fixed';
        infoBox.style.top = '35%'; // Adjust these values as needed
        infoBox.style.left = '50%';
        infoBox.style.transform = 'translateX(-50%)';
      } else {
        // Hotspot is not visible, make infoBox absolute
        infoBox.style.position = 'absolute';
        infoBox.style.top = '30px';
        infoBox.style.left = '40px';
        infoBox.style.transform = 'none';
      }
    });
  }

  // Adjust the position of each hotspot based on device type
  hotspots.forEach(function (hotspot) {
    hotspot.addEventListener('click', function (event) {
      event.stopPropagation();
      hideAllInfoBoxes();
      const infoBox = hotspot.querySelector('.hotspot-info');
      infoBox.classList.toggle('hidden');
      infoBox.classList.toggle('visible');
      event.preventDefault();
    });
  });

  // Hide info boxes on click outside of hotspots
  document.addEventListener('click', function (event) {
    let isHotspot = event.target.closest('.hotspot');
    if (!isHotspot) {
      hideAllInfoBoxes();
    }
  });

  // Add event listener for scrolling to update the position of the info panel on mobile
  if (isMobile) {
    window.addEventListener('scroll', function() {
      hideAllInfoBoxes();
      updatePosition();
    });
  }
});


</script>
 


{% style %}

.shop-the-look {
  text-align: center; min-height:50vh; margin-bottom:20px;
}
.shop-the-look-container{position:relative; overflow:hidden;}
.shop-the-look-container .content-wrap{
  position:absolute;
  left:0; top:0;
  width:100%; height:100%;
  display:flex;
  justify-content:center;
  z-index:1;
}
  .shop-the-look-container .text-overlay{
    width:1200px;  
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    text-align:center;
    box-sizing:border-box;
   }
  .shop-the-look-container .text-overlay .top-text{
   margin-top:90px; color:#fff;
  }
  .top-text h2{
    font-size:48px;
  }
  .top-text h3{
    font-size:32px;
  }
  .top-text em{
    font-style:normal; font-weight:bold; display:inline-block;
        font-size: 100px;
    font-weight: bold;
    background: linear-gradient(45deg, #00b1d2,#ffef75 );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;   
    -webkit-text-fill-color: transparent;  
    -webkit-text-stroke-width: 1px;  
    -webkit-text-stroke-color: white; 
  }
  .shop-the-look-container .text-overlay .bottom-text{
   margin-bottom:60px; color:#fff; font-size:18px;
  }
.hotspot-container {
  position: relative;
  display: inline-block;
}

.look-image {
  width: 100%;
  max-width: 1000px;
  height: auto;
}

/* Hotspot styling */
.hotspot {
  position: absolute;
  cursor: pointer;
  display: inline-block;
  z-index:2;
}
/* Desktop styles */
.hotspot {
  top: var(--hotspot-top, 50%); /* Default value */
  left: var(--hotspot-left, 50%); /* Default value */
}

/* Mobile styles */
@media (max-width: 768px) {
  .hotspot {
    top: var(--hotspot-mobile-top, 50%); /* Default value for mobile */
    left: var(--hotspot-mobile-left, 50%); /* Default value for mobile */
    pointer-events: auto; 
  }
  
}
  .hotspot-icon{
    padding:{{ section.settings.desktop_expand }}px; border-radius:50%;
  }
 .hotspot-icon i{
    position:relative;
    display: inline-block;
    width: 16px;
    height: 16px;
    margin: -8px 0 0 -8px;
    background: #ffffff;
    border-radius: 100%;
    box-shadow: 0 1px 10px rgba(0,0,0,0.25);
    cursor: pointer;
    z-index: 1;
    transform: scale(1);
    transition: transform 0.25s ease-in-out;
 
  }
   .hotspot-icon i:hover  {
    transform: scale(1.3);
  }
   .hotspot-icon i::after {
    position: absolute;
    content: '';
    width: 40px;
    height: 40px;
    left: -12px;
    top: -12px;
    border-radius: 100%;
    background: rgba(255,255,255,0.4);
    -webkit-animation: 1.4s shopTheLookDotKeyframe ease-in-out infinite;
    animation: 1.4s shopTheLookDotKeyframe ease-in-out infinite;
  }
  
 
.hotspot-info {
  display: flex;  
  gap:10px;
  opacity: 0;
  transform: scale(0.9);  
  position: absolute;
  z-index:99!important;
  top: 30px;
  left: 40px;
  background-color: white;
  border: 1px solid #ddd;
  padding: 10px;
  min-width: 300px; 
  border-radius:15px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
