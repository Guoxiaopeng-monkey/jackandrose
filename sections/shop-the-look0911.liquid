  <section class="shop-the-look"  >
  <div class="shop-the-look-container">
   <div class="content-wrap">
     <div class="text-overlay">
      <div class="top-text ">
    <h2 class="wow fadeInLeft animated" data-wow-duration="1s" data-wow-delay="0.2s">{{ section.settings.title }}</h2>
    <h3  class="wow fadeInLeft animated" data-wow-duration="1s" data-wow-delay="0.5s">{{ section.settings.subtitle }}</h3>
           {%- if section.settings.cta_text != blank -%}
                          <a href="{{ section.settings.cta_link }}" class="btn btn-animated wow fadeInLeft animated {% unless accent_exists %}  btn--inverse{% endunless %}"  data-wow-duration="1s" data-wow-delay="0.8s">
                           <span> {{ section.settings.cta_text }} </span>
                          </a>
                        {%- endif -%}
      </div>
       <div class="bottom-text">
           {%- if section.settings.cta_text != blank -%}
                       <p>   <a href="{{ section.settings.cta_link }}" class="btn btn-animated wow fadeInLeft animated only-mobile{% unless accent_exists %}  btn--inverse{% endunless %}"  data-wow-duration="1s" data-wow-delay="0.8s">
                           <span> {{ section.settings.cta_text }} </span>                         
                          </a>
                       </p>
                 {%- endif -%}
        <p>   {{ section.settings.bottom_text }} </p>
       </div>
     </div>
   </div>
    <!-- Background Image -->
    <div class="shop-the-look-image" style="position: relative;">
      <img class="hidden-mobile" src="{{ section.settings.image | img_url: 'master' }}" alt="Shop the Look Image" style="width: 100%; height: auto;">
     <img class="visible-mobile"  src="{{ section.settings.mobile_image | img_url: 'master' }}" alt="Shop the Look Image" style="width: 100%; height: auto;">
      <!-- Hotspots for Products -->
{% for block in section.blocks %}
  <div class="hotspot" 
           style="--hotspot-top: {{ block.settings.top }}%; --hotspot-left: {{ block.settings.left }}%;
                  --hotspot-mobile-top: {{ block.settings.mobile_top }}%; --hotspot-mobile-left: {{ block.settings.mobile_left }}%;">
        <span class="hotspot-icon"><i></i></span>
  <div class="hotspot-info hidden">
    {% if block.settings.product.featured_image %}
    <img src="{{ block.settings.product.featured_image | img_url: 'small' }}" alt="{{ block.settings.product.title }}" class="product-image">
    {% endif %}
    <a href="{{ block.settings.product.url }}" class="{{ section.settings['button-class'] }}">
      <h3 class="product-title">{{ block.settings.product.title }}</h3>
      <p class="product-price">{{ block.settings.product.price | money }}</p>
    </a>
  </div>
</div>
{% endfor %}
    </div>
  </div>
</section>



