{{ 'spk-country-selector.css' | asset_url | stylesheet_tag }}
<script src="{{ 'spk-country-selector.js' | asset_url }}" defer></script>

<div
  class="country-selector"
  data-country-selector-section
  data-insert-position="{{ section.settings.insert_position }}"
  data-mobile-insert-position="{{ section.settings.mobile_insert_position }}"
  data-custom-selector="{{ section.settings.custom_selector }}"
  data-mobile-custom-selector="{{ section.settings.mobile_custom_selector }}"
  data-enable-ip-detection="{{ section.settings.enable_ip_detection }}"
  data-default-country="{{ section.settings.default_country }}"
>
  <div class="country-selector__trigger" data-country-selector-trigger>
    <div class="country-selector__current">
      {% if section.settings.show_flags %}
        <div class="country-selector__flag-wrapper">
          {% render 'spk-country-flag-icons', icon: section.blocks.first.settings.flag_code %}
        </div>
      {% endif %}
      <div class="country-selector__info">
        <div class="country-selector__text-wrapper">
          <span class="country-selector__name">{{ section.blocks.first.settings.country_name }}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="country-selector__modal" data-country-selector-modal>
    <div class="country-selector__modal-content">
      <button class="country-selector__close" data-country-selector-close aria-label="关闭">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="country-selector__modal-title">{{ section.settings.modal_title }}</div>
      <div class="country-selector__options">
        {% for block in section.blocks %}
          <a
            href="{{ block.settings.link }}"
            class="country-selector__option"
            {{ block.shopify_attributes }}
            data-country-code="{{ block.settings.flag_code }}"
            tabindex="0"
          >
            {% if section.settings.show_flags %}
              <div class="country-selector__flag-wrapper">
                {% render 'spk-country-flag-icons', icon: block.settings.flag_code %}
              </div>
            {% endif %}
            <div class="country-selector__option-content">
              <div class="country-selector__text-wrapper">
                <span class="country-selector__option-name">{{ block.settings.country_name }}</span>
                <span class="country-selector__option-language">{{ block.settings.language }}</span>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SPK Country Selector",
  "enabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "modal_title",
      "label": "弹窗标题",
      "default": "选择国家/地区"
    },
    {
      "type": "checkbox",
      "id": "show_flags",
      "label": "显示国旗",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_ip_detection",
      "label": "启用 IP 检测",
      "default": true,
      "info": "根据用户 IP 自动选择默认国家"
    },
    {
      "type": "select",
      "id": "default_country",
      "label": "默认国家",
      "options": [
        {
          "value": "us",
          "label": "美国"
        },
        {
          "value": "eu",
          "label": "欧盟"
        }
      ],
      "default": "us",
      "info": "当 IP 检测失败或禁用时使用的默认国家"
    },
    {
      "type": "select",
      "id": "insert_position",
      "label": "PC端插入位置",
      "options": [
        {
          "value": "header",
          "label": "页面顶部"
        },
        {
          "value": "footer",
          "label": "页面底部"
        },
        {
          "value": "custom",
          "label": "自定义位置"
        }
      ],
      "default": "header"
    },
    {
      "type": "select",
      "id": "mobile_insert_position",
      "label": "移动端插入位置",
      "options": [
        {
          "value": "header",
          "label": "页面顶部"
        },
        {
          "value": "footer",
          "label": "页面底部"
        },
        {
          "value": "custom",
          "label": "自定义位置"
        }
      ],
      "default": "header"
    },
    {
      "type": "text",
      "id": "custom_selector",
      "label": "PC端自定义选择器",
      "info": "当选择'自定义位置'时，在此输入要插入的DOM元素选择器",
      "default": "#custom-position"
    },
    {
      "type": "text",
      "id": "mobile_custom_selector",
      "label": "移动端自定义选择器",
      "info": "当选择'自定义位置'时，在此输入要插入的DOM元素选择器",
      "default": "#mobile-custom-position"
    }
  ],
  "blocks": [
    {
      "type": "country",
      "name": "国家选项",
      "settings": [
        {
          "type": "select",
          "id": "flag_code",
          "label": "国旗",
          "options": [
            {
              "value": "cn",
              "label": "中国"
            },
            {
              "value": "us",
              "label": "美国"
            },
            {
              "value": "eu",
              "label": "欧盟"
            },
            {
              "value": "jp",
              "label": "日本"
            },
            {
              "value": "kr",
              "label": "韩国"
            },
            {
              "value": "gb",
              "label": "英国"
            },
            {
              "value": "de",
              "label": "德国"
            },
            {
              "value": "fr",
              "label": "法国"
            },
            {
              "value": "it",
              "label": "意大利"
            },
            {
              "value": "es",
              "label": "西班牙"
            },
            {
              "value": "ru",
              "label": "俄罗斯"
            },
            {
              "value": "se",
              "label": "瑞典"
            },
            {
              "value": "dk",
              "label": "丹麦"
            },
            {
              "value": "fi",
              "label": "芬兰"
            },
            {
              "value": "no",
              "label": "挪威"
            },
            {
              "value": "ie",
              "label": "爱尔兰"
            },
            {
              "value": "pt",
              "label": "葡萄牙"
            },
            {
              "value": "gr",
              "label": "希腊"
            },
            {
              "value": "pl",
              "label": "波兰"
            },
            {
              "value": "nl",
              "label": "荷兰"
            },
            {
              "value": "be",
              "label": "比利时"
            },
            {
              "value": "ch",
              "label": "瑞士"
            },
            {
              "value": "ca",
              "label": "加拿大"
            }
          ],
          "default": "cn"
        },
        {
          "type": "text",
          "id": "country_name",
          "label": "国家名称",
          "default": "中国"
        },
        {
          "type": "text",
          "id": "language",
          "label": "语言",
          "default": "简体中文"
        },
        {
          "type": "url",
          "id": "link",
          "label": "跳转链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SPK Country Selector",
      "blocks": [
        {
          "type": "country"
        }
      ]
    }
  ],
  "limit": 1
}
{% endschema %}
