<style>
  #shopify-section-{{ section.id }}.spk-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .spk-section-title{
    color:{{ section.settings.title_color }};
  }
  .spk-section-title{
    font-size: 36px;
  }
  .spk-section-title.title-left{
    text-align: left;
  }
  .spk-section-title.title-center{
    text-align: center;
  }

  .spk-product-grid-content {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-gap: 20px;
    margin-top:40px;
  }
  .spk-product-grid-content.spk-container{
    padding: 0;
  }
  .spk-product-grid-content.page-width,
  .spk-product-grid.page-width{
    padding:0 0;
  }
  .spk-product-grid-card {
    grid-column: span 1 / span 1;
    grid-row: span 1 / span 1;
  }
  .spk-product-grid-card.spk-product-grid-image {
    grid-column: span 2 / span 2;
    grid-row: span 2 / span 2;
    border-radius: 24px;
    overflow: hidden;
  }
  .placeholder_img,
  .spk-product-grid-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
<style>
  @media (max-width: 767.98px) {
    #shopify-section-{{ section.id }}.spk-section {
      padding-top: {{ section.settings.padding_top | divided_by:2 }}px;
      padding-bottom: {{ section.settings.padding_bottom | divided_by:2 }}px;
    }
    .spk-section-title{
      font-size: 24px;
    }
    .spk-product-grid-content {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-gap: 12px;
      margin-top:24px;
    }
    .spk-section .spk-product-grid.page-width{
      padding:0 var(--pageWidthPadding);
    }
    .spk-product-grid-card.spk-product-grid-image {
      grid-column: span 2 / span 2;
      grid-row: span 2 / span 2;
      border-radius: 24px;
      overflow: hidden;
    }
    {% if section.settings.mb_cover %}
      #shopify-section-{{ section.id }} .spk-product-grid-image {
        display: none;
      }
    {% endif %}
  }
</style>

<div class="spk-product-grid page-width spk-container" id="{{ section.settings.target_id }}">
  {% if section.settings.title %}
    <h2 class="spk-section-title {{ section.settings.layout }}">{{ section.settings.title }}</h2>
  {% endif %}
  <div class="spk-product-grid-content page-width">
    {%- if section.settings.url != blank -%}<a href="{{ section.settings.url }}" target="_blank" class="spk-product-grid-card spk-product-grid-image">{%- endif -%}
    <div class="spk-product-grid-card spk-product-grid-image">
      {%- if section.settings.image_pc != blank -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source
              media="(max-width: 699px)"
              srcset="{{ section.settings.image_mobile | image_url: width: '400x' }} 400w, {{ section.settings.image_mobile | image_url: width: '600x' }} 600w, {{ section.settings.image_mobile | image_url: width: '800x' }} 800w, {{ section.settings.image_mobile | image_url: width: '1000x' }} 1000w, {{ section.settings.image_mobile | image_url: width: '1200x' }} 1200w"
              width="{{ section.settings.image_mobile.width }}"
              height="{{ section.settings.image_mobile.height }}"
            >
          {%- endif -%}
          <img
            src="{{ section.settings.image_pc | image_url }}"
            alt="{{ section.settings.title | default: shop.name}}"
            width="100%"
            height="auto"
            loading="lazy"
          >
        </picture>
      {% else %}
        {{- 'lifestyle-1' | placeholder_svg_tag: 'placeholder_img' -}}
      {%- endif -%}
    </div>
    {%- if section.settings.url != blank -%}</a>{%- endif -%}
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      {%- if product != blank -%}
        <div class="spk-product-grid-card">
          {%- render 'e_product-card', product: product, title: block.settings.title -%}
        </div>
      {% endif %}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "SPK Image Product Grid",
  "class": "spk-section",
  "settings": [
    {
      "type": "text",
      "id": "target_id",
      "label": "Target ID",
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "SparkX Title"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout PC",
      "default": "title-left",
      "options": [
        {
          "value": "title-left",
          "label": "Title Left"
        },
        {
          "value": "title-center",
          "label": "Title Center"
        }
      ]
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#F47C20"
    },
    {
      "type": "checkbox",
      "id": "card_rounded",
      "label": "Card Rounded",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image_pc",
      "label": "Image PC"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image Mobile"
    },
    {
      "type": "checkbox",
      "id": "mb_cover",
      "label": "Hidden Mobile Cover Image",
      "default": false
    },
    {
      "type": "url",
      "id": "url",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "display_title_type",
      "label": "Title type",
      "options": [
        { "value": "collection", "label": "Collection" },
        { "value": "bundles", "label": "Bundles" },
        { "value": "discount", "label": "Discount" },
        { "value": "default", "label": "Default" }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "display_special_attr",
      "label": "Display special attribute",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 10
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Product Grid"
    }
  ]
}
{% endschema %}
