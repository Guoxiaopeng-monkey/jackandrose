{% style %}
  .image-content-section {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .image-content-section img {
    width: 100%;
    height: auto;
    display: block;
  }
  .image-content-wrapper {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    color: #fff;
    max-width: 460px;
  }
  .image-content-wrapper h2 {
    margin: 0 0 12px;
    letter-spacing: 0px;
    font-size: 36px;
  }
  .image-content-wrapper p {
    margin: 0 0 24px;
    font-size: 20px;
  }
  .image-content-wrapper a {
    display: inline-block;
    padding: 8px 25px;
    background-color: #ff7500;
    color: #fff;
    font-weight: 600;
    border-radius: 8px;
  }
  .image-content-wrapper a:hover {
    opacity: 0.8;
  }

  /* Content Position Classes */
  .top_left {
    top: 120px;
    left: calc(50vw - 640px);
    align-items: flex-start;
    text-align: left;
  }
  .top_center {
    top: 120px;
    left: 50%;
    transform: translateX(-50%);
    align-items: center;
    text-align: center;
  }
  .top_right {
    top: 120px;
    right: calc(50vw - 640px);
    align-items: flex-end;
    text-align: right;
  }

  .middle_left {
    top: 50%;
    left: calc(50vw - 640px);
    transform: translateY(-50%);
    align-items: flex-start;
    text-align: left;
  }
  .middle_center {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    align-items: center;
    text-align: center;
  }
  .middle_right {
    top: 50%;
    right: calc(50vw - 640px);
    transform: translateY(-50%);
    align-items: flex-end;
    text-align: right;
  }

  .bottom_left {
    bottom: 120px;
    left: calc(50vw - 640px);
    align-items: flex-start;
    text-align: left;
  }
  .bottom_center {
    bottom: 120px;
    left: 50%;
    transform: translateX(-50%);
    align-items: center;
    text-align: center;
  }
  .bottom_right {
    bottom: 120px;
    right: calc(50vw - 640px);
    align-items: flex-end;
    text-align: right;
  }
  .placeholder-back{
      aspect-ratio: 16/9;
      background-color: #a3a3a3;
    }
{% endstyle %}

<style>
  @media (max-width: 767.98px) {
    .image-content-wrapper {
      max-width: 100%;
      padding:0 var(--pageWidthPadding);
    }
    .image-content-wrapper h2 {
      margin: 0 0 8px;
      letter-spacing: 0px;
      font-size: 24px;
    }
    .image-content-wrapper p {
      margin: 0 0 12px;
      font-size: 14px;
    }
    .image-content-wrapper a {
      padding: 8px 25px;
      font-weight: 600;
    }


    /* Content Position Classes */
    .md\:top_left {
      top: 85px;
      left: 0;
    }
    .md\:top_center {
      top: 85px;
      left: 50%;
    }
    .md\:top_right {
      top: 85px;
      right: 0;
    }

    .md\:md-middle_left {
      top: 50%;
      left: 0;
      transform: translateY(-50%);
    }
    .md\:middle_center {
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }
    .md\:middle_right {
      top: 50%;
      right: 0;
      transform: translateY(-50%);
    }

    .md\:bottom_left {
      top:unset;
      bottom: 85px;
      left: 0;
    }
    .md\:bottom_center {
      top:unset;
      bottom: 85px;
      left: 50%;
      transform: translateX(-50%);
    }
    .md\:bottom_right {
      top:unset;
      bottom: 85px;
      right: 0;
    }
    .placeholder-back{
      aspect-ratio: 3/4;
    }
  }
</style>

<section class="image-content-section">
  {% if section.settings.image_pc %}
    <picture>
      {% if section.settings.image_mobile %}
        <source
          media="(max-width: 749px)"
          srcset="{{ section.settings.image_mobile | image_url }} 750w"
        >
      {% endif %}
      <img
        sizes="(max-width: 749px) 100vw, 100vw"
        src="{{ section.settings.image_pc | image_url }}"
        alt="Content Image"
        width="100%"
        height="auto"
        loading="lazy"
      >
    </picture>
  {% else %}
    {{    'lifestyle-1'  | placeholder_svg_tag:"placeholder-back"}}
  {% endif %}

  <div class="image-content-wrapper {{ section.settings.content_position }} {{section.settings.content_position_mb }}">
    {% if section.settings.title %}
      <h2>{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.description %}
      <p>{{ section.settings.description }}</p>
    {% endif %}
    {% if section.settings.button_label and section.settings.button_link %}
      <a href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "SPK Image with Content",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_pc",
      "label": "PC 图片"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "移动端图片"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "内容位置",
      "options": [
        { "value": "top_left", "label": "上左" },
        { "value": "top_center", "label": "上中" },
        { "value": "top_right", "label": "上右" },
        { "value": "middle_left", "label": "中左" },
        { "value": "middle_center", "label": "中中" },
        { "value": "middle_right", "label": "中右" },
        { "value": "bottom_left", "label": "下左" },
        { "value": "bottom_center", "label": "下中" },
        { "value": "bottom_right", "label": "下右" }
      ],
      "default": "middle_center"
    },
    {
      "type": "select",
      "id": "content_position_mb",
      "label": "内容位置",
      "options": [
        { "value": "md:top_left", "label": "上左" },
        { "value": "md:top_center", "label": "上中" },
        { "value": "md:top_right", "label": "上右" },
        { "value": "md:middle_left", "label": "中左" },
        { "value": "md:middle_center", "label": "中中" },
        { "value": "md:middle_right", "label": "中右" },
        { "value": "md:bottom_left", "label": "下左" },
        { "value": "md:bottom_center", "label": "下中" },
        { "value": "md:bottom_right", "label": "下右" }
      ],
      "default": "md:bottom_left"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "描述"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮文字"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "按钮链接"
    }
  ],
  "presets": [
    {
      "name": "SPK Image with Content"
    }
  ]
}
{% endschema %}
