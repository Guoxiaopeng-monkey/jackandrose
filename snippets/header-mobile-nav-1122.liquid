{%- liquid
  assign link_index = forloop.index
  assign child_list_handle = link.title | handleize | append: link_index

  assign is_collection = false
  assign is_product = false
  assign have_image = false

  # Check for collection
  if link.url contains '/collections/'
    assign lang_code_string = request.locale.iso_code | prepend: '/' | downcase
    assign subcollection_handle = link.url | remove: '/collections/' | remove: lang_code_string
    assign subcollection_drop = collections[subcollection_handle]
    if subcollection_drop.image
      assign have_image = subcollection_drop.image
    endif
    assign is_collection = true
  # Check for product
  elsif link.url contains '/products/'
    assign product_handle = link.url | remove: '/products/'
    assign product = all_products[product_handle]
    if product.metafields.custom.menu_image
      assign have_image = product.metafields.custom.menu_image | first
    elsif product.featured_media.preview_image
      assign have_image = product.featured_media.preview_image
    endif
    assign is_product = true
  endif
-%}

{%- if have_image -%}
  {%- capture menu_image -%}
    <div class="slide-nav__image">
      {%- render 'image-element',
        img: have_image,
        loading: 'eager',
        sizes: '40px'
      -%}
    </div>
  {%- endcapture -%}
{%- endif -%}

<li class="slide-nav__item">
  {%- if link.levels > 0 -%}
    <button type="button"
      class="slide-nav__button js-toggle-submenu"
      data-target="tier-2-{{ child_list_handle }}"
      {% if link.active or link.child_active %}data-active="true"{% endif %}>
      <span class="slide-nav__link">
        {%- if have_image -%}
          {{ menu_image }}
        {%- endif -%}
        <span>{{ link.title }}</span>
        {% render 'icon', name: chevron_icon %}
        <span class="icon__fallback-text visually-hidden">{{ 'actions.expand_submenu' | t }}</span>
      </span>
    </button>

    <!-- Child links handling -->
    <ul class="slide-nav__dropdown" data-parent="tier-2-{{ child_list_handle }}" data-level="2">
      <!-- Existing child links code -->
      {%- for childlink in link.links -%}
        {%- liquid
          assign child_is_collection = false
          assign child_is_product = false
          assign child_have_image = false

          if childlink.url contains '/collections/'
            assign child_collection_handle = childlink.url | remove: '/collections/'
            assign child_collection = collections[child_collection_handle]
            if child_collection.image
              assign child_have_image = child_collection.image
            endif
            assign child_is_collection = true
          elsif childlink.url contains '/products/'
            assign child_product_handle = childlink.url | remove: '/products/'
            assign child_product = all_products[child_product_handle]
            if child_product.metafields.custom.menu_image
              assign child_have_image = child_product.metafields.custom.menu_image | first
            elsif child_product.featured_media.preview_image
              assign child_have_image = child_product.featured_media.preview_image
            endif
            assign child_is_product = true
          endif
        -%}

        {%- if child_have_image -%}
          {%- capture child_menu_image -%}
            <div class="slide-nav__image">
              {%- render 'image-element',
                img: child_have_image,
                loading: 'eager',
                sizes: '40px'
              -%}
            </div>
          {%- endcapture -%}
        {%- endif -%}

        <li class="slide-nav__item">
          <a href="{{ childlink.url }}" class="slide-nav__link">
            {%- if child_have_image -%}
              {{ child_menu_image }}
            {%- endif -%}
            <span>{{ childlink.title | escape }}</span>
            {% render 'icon', name: chevron_icon %}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <a href="{{ link.url }}" class="slide-nav__link">
      {%- if have_image -%}
        {{ menu_image }}
      {%- endif -%}
      <span>{{ link.title | escape }}</span>
      {% render 'icon', name: chevron_icon %}
    </a>
  {%- endif -%}
</li>

{% style %}
.slide-nav__image {
  width: 40px;
  height: 40px;
  margin-right: 10px;
  flex-shrink: 0;
}

.slide-nav__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.slide-nav__link {
  display: flex;
  align-items: center;
}
{% endstyle %}