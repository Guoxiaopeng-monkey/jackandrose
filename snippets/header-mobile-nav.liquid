
    {% liquid
      assign chevron_icon = 'chevron-down'
    %}

<div class="slide-nav__wrapper overlay" data-level="1">
  <div class="mobile_nav__header">
    <span> MENU </span>
    <svg xmlns="http://www.w3.org/2000/svg"  aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewbox="0 0 64 64"><path d="m19 17.61 27.12 27.13m0-27.13L19 44.74" style="stroke-miterlimit:10"></path></svg>
  </div>
  <ul class="slide-nav e_slide-nav">
    {%- for link in main_menu.links -%}
      {%- liquid
        assign link_index = forloop.index
        assign child_list_handle = link.title | handleize | append: link_index
        assign have_image = false
        assign is_product_menu = false

        # First check if this is a product/collection menu
        if link.links.size > 0
          assign first_child = link.links | first
          # Check product and collection links separately
          if first_child.url contains '/products/'
            assign is_product_menu = true
            assign is_megamenu = true
          elsif first_child.url contains '/collections/'
            assign is_product_menu = true
            assign is_megamenu = true
          endif
        endif


         # 遍历有无应用mega的一级菜单
       assign custom_mega = false
       for block in section.blocks
        if block.settings.target_link == link.title
         assign custom_mega = true
        endif
       endfor
         
      -%}

      {% if custom_mega %}
        <li class="slide-nav__item custom_mega">
          <button type="button"
            class="slide-nav__button js-toggle-submenu"
            data-target="tier-2-{{ child_list_handle }}"
            >
            <span class="slide-nav__link">
              <span>{{ link.title }}</span>
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" role="presentation" class="icon icon--wide icon-chevron-down" viewBox="0 0 28 16"><path fill="none" stroke="#000" stroke-width="2" d="m1.57 1.59 12.76 12.77L27.1 1.59"></path></svg>
              
              <span class="icon__fallback-text visually-hidden">{{ 'actions.expand_submenu' | t }}</span>
            </span>
          </button>

            <ul class="slide-nav__dropdown" data-parent="tier-2-{{ child_list_handle }}" data-level="2" style="display:none;">
               {% assign mega_blocks = section.blocks | where: 'type','mega' %}
               {% for block in mega_blocks %}
                  {% if block.settings.target_link == link.title %}
                    <li class="slide-nav__mega_item">
                       <div data-group="{{ block.settings.target_link | append:is_first | handle }}" class="group_name-item ">
                         {{ block.settings.group_name }}
                         <span>
                           <a href="{{ block.settings.link }}">
                             View More
                           </a>
                           <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" role="presentation" class="icon icon--wide icon-chevron-down" viewBox="0 0 28 16"><path fill="none" stroke="#000" stroke-width="2" d="m1.57 1.59 12.76 12.77L27.1 1.59"></path></svg>
                         </span>
                       </div>
                        <div class="" style="display:none;    background: #fafafa;">
                          {% if block.settings.product_list != blank %}
                             <div class="slide-nav__grid">
                              {%- for product in block.settings.product_list -%}
                                <div class="slide-nav__grid-item">
                                  <a href="{{ product.url }}" class="slide-nav__grid-link">
                                    <div class="slide-nav__grid-image">
                                        {% render 'image-element', img: product.featured_image, sizeVariable: '200px', lazy: true %}
                                      {% for tag in product.tags %}
                                           {% if tag contains 'TAG_' %}
                                             <div class="e_product_badge_new" style="color:{{ settings.product_new_color }}; background: url({{ settings.product_new_bg | img_url:"master" }}) no-repeat center;background-size: contain;">
                                               {{ tag | remove:'TAG_' }}
                                             </div>
                                             {% break %}
                                            {%endif%}
                                         {% endfor %}
                                    </div>
                                    <div class="slide-nav__grid-text">
                                      {% if product.metafields.custom.subtitle.value != blank %}
                                         <span class="slide-nav__grid-subtitle">{{ product.metafields.custom.subtitle.value }}</span>
                                       {% endif %}
                                      <p class="slide-nav__grid-title">{{ product.metafields.custom.nav_product_title| default:product.title }}</p>
                                    </div>
                                  </a>
                                </div>
                              {%- endfor -%}
                             </div>
                          {% endif %}
                         {% if block.settings.bottom_menu.links != blank %}
                          <div class="group_menu">
                              {% for menu_link in block.settings.bottom_menu.links %}
                                <a href="{{ menu_link.url }}" class="group_menu_link">
                                  {{ menu_link.title }} {% render 'icon', name: 'chevron-right' %}
                                </a>
                              {% endfor %}
                          </div>
                          {% endif %}
                         {% if block.settings.btn != blank %}
                           <div class="group_btn_wrap">
                            <a href="{{ block.settings.link }}" class="group_btn">{{ block.settings.btn }}{% render 'icon', name: 'chevron-right' %}</a>
                           </div>
                          {% endif %}
                        </div>
                    </li>
                  {% endif %}
               {% endfor%}
            </ul>
      </li>
      {% else %}
      <li class="slide-nav__item">
        {%- if link.levels > 0 -%}
          <button type="button"
            class="slide-nav__button js-toggle-submenu"
            data-target="tier-2-{{ child_list_handle }}"
            {% if link.active or link.child_active %}data-active="true"{% endif %}>
            <span class="slide-nav__link">
              <span>{{ link.title }}</span>
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" role="presentation" class="icon icon--wide icon-chevron-down" viewBox="0 0 28 16"><path fill="none" stroke="#000" stroke-width="2" d="m1.57 1.59 12.76 12.77L27.1 1.59"></path></svg>
              <span class="icon__fallback-text visually-hidden">{{ 'actions.expand_submenu' | t }}</span>
            </span>
          </button>

          {%- if is_product_menu -%}
            <ul class="slide-nav__dropdown" data-parent="tier-2-{{ child_list_handle }}" data-level="2" style="display:none;">

              <div class="slide-nav__grid">
                {%- for menu_link in link.links -%}
                  {%- liquid
                    assign is_collection = false
                    assign collection = nil
                    assign product = nil
                    
                    if menu_link.url contains '/collections/'
                      assign is_collection = true
                      assign collection_handle = menu_link.url | split: '/collections/' | last
                      assign collection = collections[collection_handle]
                    else
                      assign product_handle = menu_link.url | split: '/products/' | last
                      assign product = all_products[product_handle]
                    endif
                  -%}
                  
                  <div class="slide-nav__grid-item">
                    <a href="{{ menu_link.url }}" class="slide-nav__grid-link">
                      <div class="slide-nav__grid-image">
                        {% if is_collection and collection != blank %}
                          {% if collection.metafields.custom.cover_image != blank %}
                            <img src="{{ collection.metafields.custom.cover_image | image_url:width:160 }}" loading="lazy">
                          {% elsif collection.image != blank %}
                            {% render 'image-element', img: collection.image, sizeVariable: '160px', lazy: true %}
                          {% endif %}
                        {% elsif product != blank %}
                          {% if product.metafields.custom.cover_image %}
                            <img src="{{ product.metafields.custom.cover_image | image_url:width:160 }}" loading="lazy">
                          {% else %}
                            {% render 'image-element', img: product.featured_image, sizeVariable: '160px', lazy: true %}
                          {% endif %}
                        {% endif %}
                      </div>
                      <div class="slide-nav__grid-text">
                        <p class="slide-nav__grid-title">{{ menu_link.title }}</p>
                        {% if product.metafields.custom.subtitle != blank %}
                          <!-- <p class="slide-nav__grid-subtitle">{{ product.metafields.custom.subtitle }}</p> -->
                        {% endif %}
                      </div>
                    </a>
                  </div>
                {%- endfor -%}
              </div>
            </ul>
          {%- else -%}
            <ul class="slide-nav__dropdown" data-parent="tier-2-{{ child_list_handle }}" data-level="2" style="display:none;">
              {%- for childlink in link.links -%}
                <li class="slide-nav__item">
                  <a href="{{ childlink.url }}" class="slide-nav__link e_slide-nav__link__level2">
                    <span>{{ childlink.title }}</span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- else -%}
          <a href="{{ link.url }}" class="slide-nav__link">
            <span>{{ link.title }}</span>
          </a>
        {%- endif -%}
      </li>
      {% endif %}
    {%- endfor -%}
  </ul>
</div>

