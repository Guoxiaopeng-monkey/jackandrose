<script>
  $('button[aria-controls="MobileNav"]').on('click',function(){
    $(this).addClass('is-acitve');
    $('#MobileNav').addClass('is-acitve');
  })
  $('.mobile_nav__header svg').on('click',function(){
    $('button[aria-controls="MobileNav"]').removeClass('is-acitve');
    $('#MobileNav').removeClass('is-acitve');
    
  })
  $(".e_slide-nav .slide-nav__item button.js-toggle-submenu").on('click',function(){
    $(this).toggleClass('is-acitve');
    $(this).next().slideToggle();
  })
  $(".e_slide-nav .group_name-item").on('click',function(){
    $(this).toggleClass('is-acitve');
    $(this).next().slideToggle();
  })
</script>

{% style %}
  #MobileNav{
    display: block;
    height: 100vh;
    --z-index-header-drawers-mobile: 9;
    padding: 0 0 20px;
        opacity: 0;
  }
  #MobileNav.is-acitve{
    transform: translateY(0);
        opacity: 1;
  }
  #MobileNav .slide-nav__wrapper:after{
    display:none;
  }
  .mobile_nav__header{
    padding:12px 16px;
    color: #000;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.64px;
    display:flex;
    justify-content:space-between;
    align-items:center;
  }
  .mobile_nav__header svg{
    width:24px;
    height:24px;
  }
  .e_slide-nav .slide-nav__link{
    padding:12px 21px 12px 16px;
  }
  .e_slide-nav .slide-nav__button{
    border-bottom: 0.5px solid rgba(0, 0, 0, 0.10);
  }
  .e_slide-nav{
    border-top: 0.5px solid rgba(0, 0, 0, 0.10);
    
  }
  .e_slide-nav button.js-toggle-submenu svg{
    margin:0;
    width: 14px;
    height: 14px;
        stroke-width: 3px;
  }
  .e_slide-nav button.js-toggle-submenu.is-acitve svg{
        transform: rotate(180deg);
  }
  .e_slide-nav .slide-nav__dropdown{
    opacity:1;
    display:block;
    visibility:unset;
    position:unset;
  }
  .e_slide-nav .slide-nav__grid{
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px 16px;
    padding: 20px 16px;
    text-align: center;
  }
  .e_slide-nav .slide-nav__grid-image {
    position:relative;
  }
  .custom_mega .e_product_badge_new {
    position: absolute;
    right: 2%;
    top: 2%;
    z-index: 3;
    color: #fff;
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    /* background: url(//oneisall.com/cdn/shop/files/Vector_87e12308-2918-4e3c-a674-f52ae10848fa_60x.png?v=1736302222) no-repeat center;
    background-size: contain; */
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 4px;
  }
  .e_slide-nav .slide-nav__grid-image img{
    border-radius: 16px;
    display:block;
    overflow:hidden;
    width:100%;
    height:100%;
      aspect-ratio: 1;
    object-fit: cover;
  }
  .e_slide-nav>li>a {
    font-weight: 400;
    padding: 15px 21px 15px 16px!important;
    border-bottom: 0.5px solid rgba(0, 0, 0, 0.10);
    
}
  .e_slide-nav .slide-nav__grid-text {
    margin-top:12px;
  }
  .e_slide-nav .slide-nav__grid-subtitle {
    margin-bottom:4px;
    font-size: 14px;
  }
  .e_slide-nav .slide-nav__grid-title {
    color: #000;
    margin-top:4px;
    text-align: center;
    font-size: 12px;
    font-weight:400;
    font-style: normal;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .e_slide-nav .e_slide-nav__link__level2{
    padding:12px 16px 12px 26px;
    font-weight: 500;
    color:#00000099;
  }
  .e_slide-nav .slide-nav__mega_item{
    margin:0;
  }
  .e_slide-nav .group_name-item{
    padding:14px 21px 14px 30px ;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-bottom: 0.5px solid rgba(0, 0, 0, 0.10);
    color: #00000099;
    font-weight: 500;
  }
  .e_slide-nav .slide-nav__dropdown>li:first-child .group_name-item {
    /* border-top: 0.5px solid rgba(0, 0, 0, 0.10); */
    
  }
  .e_slide-nav .slide-nav__mega_item .group_name-item a{
    color: #00000099;
    font-weight: 500;
    margin-right:16px;
  }
  .e_slide-nav .slide-nav__mega_item .group_name-item:not(.is-acitve) a{
    display:none;
  }
  
  .e_slide-nav .group_name-item svg{
    width: 14px;
    height: 14px;
  }
  .e_slide-nav button.js-toggle-submenu svg path,
  .e_slide-nav .group_name-item svg path{
        stroke-width: 3px;
  }
  .e_slide-nav .group_name-item.is-acitve{
    color:#F47C20;
  }
  .e_slide-nav .group_name-item.is-acitve svg{
        transform: rotate(180deg);
  }
  .e_slide-nav .group_menu {
    padding: 10px 16px 20px;
  }
  .e_slide-nav .group_menu .group_menu_link {
    color: rgba(0, 0, 0, 0.80);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.4;
    margin-bottom:8px;
    margin-right: 8px;
    display: inline-block;
  }
  .e_slide-nav .group_menu .group_menu_link svg{
    width: 8px;
    height: 8px;
  }
  .e_slide-nav .group_btn_wrap{
    padding: 0px 16px 20px;
  }
  .e_slide-nav .group_btn{
   display:flex;
        justify-content: center;
    align-items: center;
    border-radius: 24px;
  background: #000;
    color:#fff;
    font-weight: 500;
    font-size: 14px;
    line-height: 1.4; 
    padding:8px;
    min-height:44px;
    gap:4px;
  }
  .e_slide-nav .group_btn svg{
    width: 12px;
    height: 12px;
  }
  .e_slide-nav .slide-nav__item:first-child{
    padding-top:0;
  }
