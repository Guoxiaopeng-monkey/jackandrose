</svg>

        </a>
  </div>
    {% endif %}
{%- if divider -%}</div>{%- endif -%}
<style>
  .faq-title {
  font-size:1.3rem;
  margin: 0;
  padding: 10px 0px 0;
  cursor: pointer;
  display:flex;
  justify-content:space-between;
}
.faq-icon{  transition: transform 0.3s ease;}
.faq-title[aria-expanded="true"] .faq-icon {
  transform: rotate(180deg);
}
 .faq-title svg{
   width:18px; height:18px;
 }
.faq-content {
  display: none; 
  padding: 10px 0px 10px 30px;
  background-color: #fff;
}
  .brochure-download{display:flex; align-items:center; justify-content:space-between; margin-top:15px; padding:20px 0; border-top:1px solid #e8e8e8;}
   .brochure-download span{font-size:1.3rem; font-weight:bold;}
   .brochure-download svg{width:24px; height:24px;}
  @media(max-width:768px){
  .faq-title svg{
   width:12px; height:12px;
   }
     .faq-title , .brochure-download span{
      font-size:1.1rem;
     }
  }
</style>
<script>
$(document).ready(function() {
  $('#shopify-section-{{ section.id }} .faq-title').click(function() {
 
    const areAllVisible = $('#shopify-section-{{ section.id }} .faq-content').filter(':hidden').length === 0;

    if (areAllVisible) {
 
      $('#shopify-section-{{ section.id }} .faq-content').slideUp();
      $('#shopify-section-{{ section.id }} .faq-title').attr('aria-expanded', 'false');
    } else {
      // Expand all
      $('#shopify-section-{{ section.id }} .faq-content').slideDown();
      $('#shopify-section-{{ section.id }} .faq-title').attr('aria-expanded', 'true');
    }
  });
});

  </script>
