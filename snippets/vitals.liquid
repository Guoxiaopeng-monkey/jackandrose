{%- if request.page_type == 'index' -%}
<script>
(function(){
  // 匹配 swiper 库文件与 bundle
  var SWIPER_RE=/(?:^|\/)swiper(?:-bundle)?(?:\.min)?\.js(?:$|[?#])/i;
  // 匹配内联初始化（new Swiper(...) 或 Swiper(...)）
  var SWIPER_INLINE_RE=/\bnew\s+Swiper\b|\bSwiper\(/;

  function mark(el){
    if(!el || el.tagName!=='SCRIPT') return;
    var src=(el.src||'')+(el.getAttribute('data-src')||'');
    var code=el.textContent||el.innerText||'';
    if(SWIPER_RE.test(src) || SWIPER_INLINE_RE.test(code)){
      // 标记为已处理，避免你的延迟脚本再改它
      el.dataset.processed='1';
      // 如果被他人改成了 text/lazyload，恢复回可执行类型
      if(el.type==='text/lazyload'){ el.type=el.dataset.type||'text/javascript'; }
    }
  }

  // 1) 先扫描当前已在 DOM 里的 script
  document.querySelectorAll('script').forEach(mark);

  // 2) 再监听后续新增的节点，抢在你的 MutationObserver 前标记
  var mo=new MutationObserver(function(muts){
    for(var i=0;i<muts.length;i++){
      var nodes=muts[i].addedNodes||[];
      for(var j=0;j<nodes.length;j++){
        var n=nodes[j];
        if(n && n.nodeType===1){
          if(n.tagName==='SCRIPT') mark(n);
          if(n.querySelectorAll){
            n.querySelectorAll('script').forEach(mark);
          }
        }
      }
    }
  });
  mo.observe(document.documentElement,{childList:true,subtree:true});
})();
</script>
