    "faqs_ijrNcG": {
      "type": "faqs",
      "blocks": {
        "tab_content_JmK8jh": {
          "type": "tab_content",
          "settings": {
            "question": "What is a pet grooming vacuum and how does it work?",
            "text": "<p>It's an all-in-one grooming tool that trims, brushes, and vacuums pet hair into a built-in dustbin—keeping your home clean and fur-free.<br/></p>"
          }
        },
        "tab_content_c6HcW7": {
          "type": "tab_content",
          "settings": {
            "question": "Is this suitable for both dogs and cats?",
            "text": "<p>Yes, all our models are safe and effective for dogs and cats of various breeds and coat types.</p>"
          }
        },
        "tab_content_HEnXQP": {
          "type": "tab_content",
          "settings": {
            "question": "What’s the difference between each model?",
            "text": "<p>✔ LM2 is our best value all-rounder.<br/>✔ Cozy C1 adds a built-in drying function.<br/>✔ BM3 offers extra suction and a large XL dustbin—perfect for big shedders.<br/>✔ LM5C is ultra-quiet for sensitive pets.</p>"
          }
        },
        "tab_content_Rpa4Mk": {
          "type": "tab_content",
          "settings": {
            "question": "Are Dog Vacuums Safe For Use on Wet Fur?",
            "text": "<p>No, most dog vacuums are designed for dry fur only, as wet fur can clog the vacuum or damage its internal components. If your dog’s fur is wet, it’s best to dry them off first before using dog vacuums. Check the product specifications to see if your model has a wet/dry option.</p>"
          }
        },
        "tab_content_Mrbdx4": {
          "type": "tab_content",
          "settings": {
            "question": "Will this scare my pet?",
            "text": "<p>Most pets adjust quickly. Our devices are designed to be quieter than traditional vacuum cleaners or hairdryers.</p>"
          }
        },
        "tab_content_nUbBLR": {
          "type": "tab_content",
          "settings": {
            "question": "Is grooming at home safe for my pet?",
            "text": "<p>Yes. Our grooming kits are designed for safe, gentle use with guards, length settings, and pet-safe materials.</p>"
          }
        }
      },
      "block_order": [
