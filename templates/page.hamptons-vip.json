    "text_and_image_LcXPyw": {
      "type": "text-and-image",
      "settings": {
        "image": "shopify://shop_images/INS_97c9b6f6-c8da-4bc7-b6df-11d220badb5c.jpg",
        "image_mask": "square",
        "image2_mask": "none",
        "subtitle": "",
        "title": "GIVEAWAY 🎉🎉",
        "heading_size": "h2",
        "text": "<p>July is the month with heat and love! Oneisall teams up with Jill Zarin for a luxury lunch event to benefit cancer. We’re proud to have been a part of such an amazing event with such a great purpose! In order to thank our customers’ support, we would like to give back to our community and show love to our pets! </p><p>Here is how to enter: <br/>1️⃣For 1 entry: 1. Follow <strong>@</strong><a href=\"https://www.instagram.com/oneisall_official/\" title=\"https://www.instagram.com/oneisall_official/\"><strong>oneisall_official</strong></a> 2. Like and tag 2 people in the comments on the giveaway post pinned to <strong>@oneisall_official</strong> instagram <br/>2️⃣For extra 2 entries: visit link in <strong>@oneisall_official</strong> and sign up for our email newsletter. <br/><br/>We will announce the first entry for 2 winners on July 31 and the extra 2 entries on August 15. Join us and don’t miss out the opportunities to get a free and the best smart grooming kit for your furry friends!</p>",
        "button_label": "",
        "button_link": "",
        "button_style": "primary",
        "align_text": "center",
        "image_width": "50",
        "layout": "right",
        "color_scheme": "none",
        "show_wave": false,
        "divider": false,
        "top_padding": true,
        "bottom_padding": true
      }
