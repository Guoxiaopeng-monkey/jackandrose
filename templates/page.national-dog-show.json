        "text_HzLNAA": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p>We are thrilled to announce our sponsorship of the <strong>National Dog Show</strong>, </p><p>a prestigious event celebrating the incredible bond between humans and their canine companions.<br/><br/>At Oneisall, we believe that <strong>every dog is a champion</strong> in the eyes of its owner, deserving of recognition and love. </p><p>Through this event, we aim to highlight that each pup is a winner and deserves the best care possible.<br/><br/>Oneisall is dedicated to providing <strong>a champion-level grooming experience</strong> for every dog, ensuring they look and feel their best.<br/><br/>Join us in celebrating our furry friends and the joy they bring to our lives!</p>"
          }
        },
        "liquid_yKx9Wt": {
