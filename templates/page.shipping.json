        "text_DrhcAK": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<h2>Note</h2><p>1. Delivery to PO Boxes may fail due to logistics restrictions. Please provide a specific address or use an alternative address with specific street and apartment number for prompt delivery.</p><p>2. Non-Standard Specifications: An additional $50 shipping fee will be charged if you purchase a product with specifications not common in your country (e.g., buying a European-spec product in the United States).</p>"
          }
        }
