        "text_HXRrMK": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<h2><strong>Delivery Availability</strong></h2><p></p><ul><li>United States: All regions exclude remote areas including Alaska, Hawaii, Puerto Rico, U.S. Virgin Islands, Armed Forces Americas, Armed Forces Europe, Armed Force Pacific, and U.S. Overseas Territories.</li></ul><p></p><h2><strong>Shipping Time & Fee</strong></h2><p></p><ul><li>Estimated delivery time: It takes up to 3-5 business days to deliver your order since the time it was created. Accessories may take an additional week as they might be shipped from our warehouses outside the US.</li></ul><p></p><ul><li>Estimated delivery time during peak periods: During holidays like Black Friday, Cyber Monday, and New Year, allow up to 5 additional business days for dispatch.</li></ul><p></p><ul><li>Estimated delivery time of pre-orders: Delivery times are as indicated on the pre-sale product page.</li></ul>"
          }
        }
      },
