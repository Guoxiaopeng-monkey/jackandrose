        "tab_content_pBhcBm": {
          "type": "tab_content",
          "settings": {
            "question": "How loud is the pet vacuum grooming kit?",
            "text": "<p>The noise of our pet grooming kits is less than 50db, it is a relatively soft sound level, similar to a calm office environment, or a low-volume televisionwhich which not scare pets.</p>"
          }
        },
        "tab_content_JmK8jh": {
          "type": "tab_content",
          "settings": {
            "question": "How often do hepa filters need to be replaced?",
            "text": "<p>We recommend cleaning the lint in the dust cup after each use of the machine. If used frequently, it is recommended that the filter be replaced every six months.</p>"
          }
        },
        "tab_content_c6HcW7": {
          "type": "tab_content",
          "settings": {
            "question": "Does it work on cats?",
            "text": "<p>Yes! It works on dogs and cats alike...even more!</p>"
          }
        },
        "tab_content_RK8XUk": {
          "type": "tab_content",
          "settings": {
            "question": "Is the pet vacuum grooming kit manageable for someone with little grooming experience?",
            "text": "<p>Yes, it's user-friendly, with simple attachments that make it easy for beginners to achieve professional-looking results at home.</p>"
          }
        }
